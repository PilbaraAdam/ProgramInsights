{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // Entra ID app registration. Reuses the Benchmarks registration, which Snowflake's
  // External OAuth security integration already trusts.
  //
  // ClientId and TenantId are not secrets. ClientSecret MUST NOT be added here —
  // set it with:  dotnet user-secrets set "AzureAd:ClientSecret" "<value>"
  // and use Key Vault / App Service configuration in deployed environments.
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "7bcf6e67-6286-48e1-a366-374acbd77cd0",
    "ClientId": "0106028e-ac31-4824-a47e-3effb57d9b9e",
    "CallbackPath": "/signin-oidc",
    "SignedOutCallbackPath": "/signout-callback-oidc",
    "SignedOutRedirectUri": "/signed-out"
  },

  "Snowflake": {
    "Account": "PILBARAINSIGHTS-AU",
    // REQUIRED. The old service account relied on its DEFAULT_WAREHOUSE; per-user
    // OAuth has no such fallback and every query fails without this.
    "Warehouse": "COMPUTE_WH",
    "ControlDatabase": "PROGRAMINSIGHTS_APP",
    "ControlSchema": "SECURITY",
    "DefaultSchema": "PUBLIC",
    // Saved work for members (no client database) and for the Preview, both in
    // ControlDatabase. See SQL/Control/08 and 09.
    "WorkspaceSchema": "WORKSPACE",
    "PreviewSchema": "PREVIEW",
    "Scope": "api://0106028e-ac31-4824-a47e-3effb57d9b9e/session:role-any",
    // Pooling off deliberately: the driver's pool key is the whole connection
    // string, which now contains a rotating per-user token. A pooled session can
    // outlive both the token that created it and an APP_USERS deactivation.
    "PoolingEnabled": false,
    "ConnectionTimeoutSeconds": 30,
    "CommandTimeoutSeconds": 120,
    "TenantCacheMinutes": 15
  },

  // Private Preview deployment. Off here; the Preview App Service sets Preview:Enabled
  // = true plus ServiceUser and the key-pair private key (Preview:PrivateKey or
  // Preview:PrivateKeyPath) from Key Vault. Never put the private key in this file.
  "Preview": {
    "Enabled": false,
    "Role": "PROGRAMINSIGHTS_PREVIEW",
    "MaxFailedAttempts": 5,
    "LockoutMinutes": 15
  }

  // ConnectionStrings:Snowflake and App:TenantId are deliberately gone. Connections are
  // now built per user from their Entra token, and the tenant id comes from the
  // ROLE_DATABASE_MAP row for their Snowflake role. Re-adding either key would create a
  // silent path back to shared-service-account access.
}
