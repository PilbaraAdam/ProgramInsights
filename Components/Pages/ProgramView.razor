    private RenderFragment CrEditorCard(string label, string field) => builder =>
    {
        if (program is null) return;
        var selected = GetSource(field);
        var seq = 0;

        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "class", "cr-editor-card");

        // Title
        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "class", "cr-editor-title");
        builder.AddContent(seq++, label);
        builder.CloseElement();

        // Source buttons
        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "class", "cr-source-group");
        foreach (var option in SourceOptions(field))
        {
            var capturedOption = option;
            builder.OpenElement(seq++, "button");
            builder.AddAttribute(seq++, "type", "button");
            builder.AddAttribute(seq++, "class", $"cr-source-btn {(selected == option ? "active" : "")}");
            builder.AddAttribute(seq++, "onclick", EventCallback.Factory.Create(this, () => SetSource(field, capturedOption)));
            builder.AddContent(seq++, SourceLabel(option));
            builder.CloseElement();
        }
        builder.CloseElement();

        // Value input/display
        if (field == "RevCgs" && selected == "Cluster")
        {
            // Year selector — determines which year's FOE rates are active
            if (program.CgsClusterYearOptions.Count > 0)
            {
                builder.OpenElement(seq++, "select");
                builder.AddAttribute(seq++, "class", "dropDownList1 cr-editor-input");
                builder.AddAttribute(seq++, "value", program.CgsClusterYear.ToString());
                builder.AddAttribute(seq++, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this,
                    async e => { if (int.TryParse(e.Value?.ToString(), out var yr)) await OnCgsYearChanged(yr); }));
                foreach (var yr in program.CgsClusterYearOptions)
                {
                    builder.OpenElement(seq++, "option");
                    builder.AddAttribute(seq++, "value", yr.ToString());
                    builder.AddContent(seq++, yr.ToString() + " rates");
                    builder.CloseElement();
                }
                builder.CloseElement();
            }

            // Informational note — rates are set per unit via FOE code
            builder.OpenElement(seq++, "span");
            builder.AddAttribute(seq++, "class", "wizard-hint");
            builder.AddContent(seq++, "Rate per unit is set by the FOE code selected on each unit.");
            builder.CloseElement();

            if (!string.IsNullOrWhiteSpace(cgsYearError))
            {
                builder.OpenElement(seq++, "div");
                builder.AddAttribute(seq++, "class", "mapping-error");
                builder.AddContent(seq++, cgsYearError);
                builder.CloseElement();
            }
        }
        else if (selected == "Custom")
        {
            builder.OpenElement(seq++, "input");
            builder.AddAttribute(seq++, "type", "number");
            builder.AddAttribute(seq++, "step", "any");
            builder.AddAttribute(seq++, "class", "textBoxStyle4 cr-editor-input");
            builder.AddAttribute(seq++, "value", BindConverter.FormatValue(GetCustomValue(field)));
            builder.AddAttribute(seq++, "onchange", EventCallback.Factory.CreateBinder<double>(this, v => SetCustomValue(field, v), GetCustomValue(field)));
            builder.CloseElement();
        }
        else if (selected == "Benchmark")
        {
            builder.OpenElement(seq++, "span");
            builder.AddAttribute(seq++, "class", "wizard-hint");
            if (benchmarkData.Count == 0)
                builder.AddContent(seq++, "No benchmark data loaded. Configure filters and load data on the Benchmark tab.");
            else
            {
                var bmSrc = field == "Cph" ? "Staff Salary / Delivery Hours per EFTSL" : "Non Salary per EFTSL";
                builder.AddContent(seq++, $"Using sector weighted mean from benchmark ({bmSrc}).");
            }
            builder.CloseElement();
        }

        // Resolved value strip
        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "class", "cr-resolved");
        builder.OpenElement(seq++, "span");
        builder.AddAttribute(seq++, "class", "cr-resolved-label");
        builder.AddContent(seq++, "Effective value");
        builder.CloseElement();
        builder.OpenElement(seq++, "span");
        builder.AddAttribute(seq++, "class", "cr-resolved-value");
        builder.AddContent(seq++, FormatNumber(ResolvedValue(field)));
        builder.CloseElement();
        builder.CloseElement();

        builder.CloseElement(); // cr-editor-card
    };

    // ── Benchmark helpers ─────────────────────────────────────────

    // Called by @bind:after on each benchmark filter dropdown
    private async Task OnBenchmarkFilterChanged()
    {
        benchmarkData = new();
        benchmarkError = null;
        // A different peer group changes the resolved cost values
        if (UsesBenchmarkSource)
            MarkStale();
        // Only auto-load when at least one filter is set
        if (HasBenchmarkFilters)
        {
            await (benchmarkLoadTask = LoadBenchmarkDataAsync());
        }
    }

    private bool HasBenchmarkFilters =>
        !string.IsNullOrWhiteSpace(program?.BmDegreeLevel)
        || !string.IsNullOrWhiteSpace(program?.BmFoe)
        || !string.IsNullOrWhiteSpace(program?.BmPeriodName);

    private bool UsesBenchmarkSource =>
        GetSource("Cph") == "Benchmark" || GetSource("Nfc") == "Benchmark";

    // Loads benchmark measures once, sharing an in-flight load rather than starting another.
    private Task? benchmarkLoadTask;
    private Task EnsureBenchmarkDataAsync()
    {
        if (benchmarkData.Count > 0) return Task.CompletedTask;
        if (benchmarkLoadTask is { IsCompleted: false }) return benchmarkLoadTask;
        return benchmarkLoadTask = LoadBenchmarkDataAsync();
    }

    private async Task LoadBenchmarkFiltersAsync()
    {
        if (benchmarkFiltersLoaded || isLoadingBenchmarkFilters) return;
        isLoadingBenchmarkFilters = true;
        try
        {
            benchmarkFilters = await BenchmarkSvc.GetFilterOptionsAsync();
            benchmarkFiltersLoaded = true;
        }
        catch (Exception ex)
        {
            benchmarkError = $"Could not load benchmark filters: {ex.Message}";
        }
        finally
        {
            isLoadingBenchmarkFilters = false;
            StateHasChanged();
        }
    }

    private async Task LoadBenchmarkDataAsync()
    {
        if (program is null) return;
        isLoadingBenchmark = true;
        benchmarkError = null;
        benchmarkData = new();
        try
        {
            benchmarkData = await BenchmarkSvc.GetMeasuresAsync(
                program.BmDegreeLevel, program.BmFoe, program.BmPeriodName);
            if (benchmarkData.Count == 0)
                benchmarkError = "No benchmark data found for the selected filters. Check the peer group settings on the Details tab.";
        }
        catch (Exception ex)
        {
            benchmarkError = $"Benchmark query failed: {ex.Message}";
        }
        finally
        {
            isLoadingBenchmark = false;
            StateHasChanged();
        }
    }

    // Key measures for program-fit comparison
    // (Label, BmMeasure, ProgramValue, Format)
    private IEnumerable<(string Label, string BmMeasure, double ProgramValue, string Format)> BenchmarkFitRows()
    {
        if (program is null || benchmarkData.Count == 0) yield break;

        // Delivery hours / EFTSL from model values (if available)
        var totalMv = program.ModelValues.Sum(m => m.DomesticEftsl + m.InternationalEftsl + m.CgsEftsl);
        var deliveryHoursPerEftsl = totalMv > 0
            ? program.ModelValues.Sum(m => m.DeliveryHours) / totalMv
            : 0;

        var cph = ResolvedValue("Cph");
        var nfc = ResolvedValue("Nfc");

        // CPH: compared against Staff Salary / Delivery Hours derived benchmark
        yield return ("Faculty Cost / Hour",
            BenchmarkService.MeasureStaffSalaryPerEftsl,   // sentinel — CPH is handled specially in the table
            cph, "C0");

        yield return ("Non-Faculty Cost / EFTSL",
            BenchmarkService.MeasureNonSalaryPerEftsl,
            nfc, "C0");

        if (deliveryHoursPerEftsl > 0)
        {
            yield return ("Total Cost / EFTSL",
                BenchmarkService.MeasureCostPerEftsl,
                cph * deliveryHoursPerEftsl + nfc, "C0");

            yield return ("Delivery Hours / EFTSL",
                BenchmarkService.MeasureDeliveryHoursPerEftsl,
                deliveryHoursPerEftsl, "N1");
        }

        // Revenue and margin come from the calculation, EFTSL-weighted across all forecast years
        var costResults = calculationResult?.CostResults ?? new();
        var calcEftsl = costResults.Sum(r => r.TotalEftsl);
        if (calcEftsl > 0)
        {
            yield return ("Revenue / EFTSL",
                BenchmarkService.MeasureTotalRevPerEftsl,
                costResults.Sum(r => r.FacultyRevenue) / calcEftsl, "C0");

            yield return ("Margin / EFTSL",
                BenchmarkService.MeasureMarginPerEftsl,
                costResults.Sum(r => r.TotalMargin) / calcEftsl, "C0");
        }
    }

    // Compute where the program value sits within [min, max] as a 0-100 percentage
    private static double BmPositionPct(double programVal, double? min, double? max)
    {
        if (min is null || max is null || max <= min) return 50;
        var clamped = Math.Clamp(programVal, min.Value, max.Value);
        return (clamped - min.Value) / (max.Value - min.Value) * 100;
    }

    private async Task PersistProgram()
    {
        if (program is null) return;

        saveError = null;
        statusMessage = null;
        try
        {
            program.Settings = program.Settings.Select((setting, index) =>
            {
                setting.Year = index;
                return setting;
            }).ToList();
            await ProgramSvc.SaveDetailsAsync(program);
            program.SaveDate = DateTime.Now;
            statusMessage = "Program saved successfully.";
        }
        catch (Exception ex)
        {
            saveError = $"Error saving program: {ex.Message}";
        }
    }

    private void MarkStale()
    {
        if (calculationResult is not null)
            calculationIsStale = true;
    }

    private async Task RunCalculation()
    {
        if (program is null) return;

        isCalculating = true;
        calcError = null;
        statusMessage = null;
        exportBytes = null;
        expandedYears.Clear();
        try
        {
            await PersistProgram();
            if (!string.IsNullOrWhiteSpace(saveError)) return;

            if (UsesBenchmarkSource)
            {
                await EnsureBenchmarkDataAsync();
                var missing = new[] { "Cph", "Nfc" }
                    .Where(f => GetSource(f) == "Benchmark" && GetBenchmarkValue(f) <= 0)
                    .Select(f => f == "Cph" ? "faculty cost per hour" : "non-faculty cost per EFTSL")
                    .ToList();
                if (missing.Count > 0)
                {
                    calcError = $"No benchmark value for {string.Join(" or ", missing)}. Check the benchmark peer group on the Details tab, or switch that cost source to Custom or Model.";
                    return;
                }
            }
            program.BmCphValue = GetBenchmarkValue("Cph");
            program.BmNfcValue = GetBenchmarkValue("Nfc");

            calculationResult = CalculationSvc.Calculate(program);
            exportBytes = ExportSvc.GenerateResultsWorkbook(calculationResult, program);
            calculationIsStale = false;
            statusMessage = "Calculation complete.";
            pendingChartRender = true;
        }
        catch (Exception ex)
        {
            calculationResult = null;
            calcError = ex.Message;
        }
        finally
        {
            isCalculating = false;
        }
    }

    private async Task RenderCharts()
    {
        if (calculationResult is null || program is null) return;

        var labels = calculationResult.CostResults.Select(r => r.CalendarYear.ToString()).ToArray();
        var facultyCosts = calculationResult.CostResults.Select(r => r.FacultyCost).ToArray();
        var nonFacCosts = calculationResult.CostResults.Select(r => r.NonFacultyCost).ToArray();
        var revenues = calculationResult.CostResults.Select(r => r.FacultyRevenue).ToArray();

        await JS.InvokeVoidAsync("chartHelpers.renderCostRevenue",
            "costRevenueChart", labels, facultyCosts, nonFacCosts, revenues);

        var cohortIndices = calculationResult.HourResults
            .Select(h => h.CohortStartYearIndex).Distinct().OrderBy(i => i).ToList();

        var cohortDatasets = cohortIndices.Select(ci => new
        {
            label = $"Intake {program.StartYear + ci}",
            data = calculationResult.CostResults.Select(cr =>
            {
                var fh = calculationResult.HourResults
                    .FirstOrDefault(h => h.ForecastYearIndex == cr.YearIndex && h.CohortStartYearIndex == ci);
                return fh is null ? 0.0 : fh.DomesticEftsl + fh.InternationalEftsl + fh.CgsEftsl;
            }).ToArray()
        }).ToArray();

        await JS.InvokeVoidAsync("chartHelpers.renderEftslRampup",
            "eftslRampupChart", labels, cohortDatasets);

        await RenderBreakevenChart();
    }

    private async Task RenderBreakevenChart()
    {
        if (calculationResult is null) return;
        if (calculationResult.BreakevenResults.Count == 0) return;
        var idx = Math.Clamp(selectedBreakevenYearIndex, 0, calculationResult.BreakevenResults.Count - 1);
        var be = calculationResult.BreakevenResults[idx];
        if (be.ChartPoints.Count == 0) return;

        await JS.InvokeVoidAsync("chartHelpers.renderBreakeven",
            "breakevenChart",
            be.ChartPoints.Select(p => new { eftsl = p.Eftsl, revenue = p.Revenue, totalCost = p.TotalCost }),
            be.ProjectedEftsl);
    }

    private async Task SelectBreakevenYear(int yearIndex)
    {
        selectedBreakevenYearIndex = yearIndex;
        await RenderBreakevenChart();
    }

    private void ToggleYear(int yearIndex)
    {
        if (!expandedYears.Remove(yearIndex))
            expandedYears.Add(yearIndex);
    }

    private async Task DownloadExcel()
    {
        if (exportBytes is null || program is null) return;
        var filename = $"{program.Name.Replace(" ", "_")}_Results.xlsx";
        await JS.InvokeVoidAsync("fileHelpers.download", filename, Convert.ToBase64String(exportBytes));
    }

    private void AddProjectionYear()
    {
        if (program is null || program.Settings.Count >= 15) return;
        program.Settings.Add(new ProgramYearSettingDto { Year = program.Settings.Count });
        MarkStale();
    }

    private void RemoveProjectionYear()
    {
        if (program is null || program.Settings.Count <= 1) return;
        program.Settings.RemoveAt(program.Settings.Count - 1);
        MarkStale();
    }

    private void AddDegreeYear()
    {
        degreeYearCount++;
    }

    private void RemoveDegreeYear()
    {
        if (program is null || DegreeYearCount <= 1) return;
        program.Units.RemoveAll(u => u.ProgramYear == DegreeYearCount);
        degreeYearCount = Math.Max(1, degreeYearCount - 1);
    }

    private void OpenUnitPicker(int year, ProgramUnitDto? unit = null)
    {
        if (program is null) return;
        unitPickerYear = year;
        editingUnit = unit;

        // If editing a unit not in UnitOptions (custom-named), treat as "New Unit" with the name pre-filled
        if (unit is not null && !program.UnitOptions.Any(o => o.Name == unit.Unit))
        {
            selectedPickerUnit = "New Unit";
            newUnitCustomName = unit.Unit;
        }
        else
        {
            selectedPickerUnit = unit?.Unit ?? "New Unit";
            newUnitCustomName = "";
        }

        selectedPickerProfile = unit?.Profile ?? program.Profiles.FirstOrDefault()?.Name ?? "Standard";
        var rawFoe = unit?.FoeCodeDetailed ?? "";
        selectedPickerFoe = ResolveCanonicalFoe(rawFoe)?.FoeCodeDetailed ?? rawFoe;
        foeSearch = "";
        foeBroadFilter = "";
        foeNarrowFilter = "";

        if (unit?.Profile == "Custom")
        {
            customTutSize = unit.CustomTutSize ?? 20;
            customLectHours = unit.CustomLectHours ?? 0;
            customTutHours = unit.CustomTutHours ?? 0;
            customPrepHours = unit.CustomPrepHours ?? 0;
            customAdminHours = unit.CustomAdminHours ?? 0;
            customStudentHours = unit.CustomStudentHours ?? 0;
        }
        else
        {
            customTutSize = 20;
            customLectHours = 0;
            customTutHours = 0;
            customPrepHours = 0;
            customAdminHours = 0;
            customStudentHours = 0;
        }

        unitPickerError = false;
        unitSearch = "";
        unitSchoolFilter = "";
        isUnitPickerOpen = true;
    }

    private void CloseUnitPicker()
    {
        isUnitPickerOpen = false;
        editingUnit = null;
    }

    private void UnitPickerOverlayClick()
    {
        CloseUnitPicker();
    }

    private void SelectPickerUnit(string unit)
    {
        selectedPickerUnit = unit;
        unitPickerError = false;

        if (unit == "New Unit")
        {
            selectedPickerFoe = "";
        }
        else if (program is not null)
        {
            var option = program.UnitOptions.FirstOrDefault(o => o.Name == unit);
            var rawFoe = !string.IsNullOrWhiteSpace(option?.FoeCodeDetailed)
                ? option.FoeCodeDetailed
                : program.Units.FirstOrDefault(u => u.Unit == unit)?.FoeCodeDetailed ?? "";
            selectedPickerFoe = ResolveCanonicalFoe(rawFoe)?.FoeCodeDetailed ?? rawFoe;
        }
    }

    private void ConfirmUnitPicker()
    {
        if (program is null) return;

        var unitName = selectedPickerUnit == "New Unit"
            ? (string.IsNullOrWhiteSpace(newUnitCustomName) ? "New Unit" : newUnitCustomName.Trim())
            : selectedPickerUnit;

        if (string.IsNullOrWhiteSpace(unitName))
        {
            unitPickerError = true;
            return;
        }

        if (editingUnit is null)
        {
            var newUnit = new ProgramUnitDto
            {
                Unit = unitName,
                Profile = selectedPickerProfile,
                ProgramYear = unitPickerYear,
                FoeCodeDetailed = selectedPickerFoe
            };
            if (selectedPickerProfile == "Custom")
            {
                newUnit.CustomTutSize = customTutSize;
                newUnit.CustomLectHours = customLectHours;
                newUnit.CustomTutHours = customTutHours;
                newUnit.CustomPrepHours = customPrepHours;
                newUnit.CustomAdminHours = customAdminHours;
                newUnit.CustomStudentHours = customStudentHours;
            }
            program.Units.Add(newUnit);
        }
        else
        {
            editingUnit.Unit = unitName;
            editingUnit.Profile = selectedPickerProfile;
            editingUnit.ProgramYear = unitPickerYear;
            editingUnit.FoeCodeDetailed = selectedPickerFoe;
            if (selectedPickerProfile == "Custom")
            {
                editingUnit.CustomTutSize = customTutSize;
                editingUnit.CustomLectHours = customLectHours;
                editingUnit.CustomTutHours = customTutHours;
                editingUnit.CustomPrepHours = customPrepHours;
                editingUnit.CustomAdminHours = customAdminHours;
                editingUnit.CustomStudentHours = customStudentHours;
            }
            else
            {
                editingUnit.CustomTutSize = null;
                editingUnit.CustomLectHours = null;
                editingUnit.CustomTutHours = null;
                editingUnit.CustomPrepHours = null;
                editingUnit.CustomAdminHours = null;
                editingUnit.CustomStudentHours = null;
            }
        }

        MarkStale();
        CloseUnitPicker();
    }

