    private double ResolvedValue(string field) => GetSource(field) switch
    {
        "Model" => GetModelValue(field),
        "Cluster" when field == "RevCgs" => FoeAverageCgsRate(),
        "Benchmark" => GetBenchmarkValue(field),
        _ => GetCustomValue(field)
    };

    private double GetBenchmarkValue(string field)
    {
        if (benchmarkData.Count == 0) return 0;
        if (field == "Nfc")
            return benchmarkData.FirstOrDefault(m => m.Measure == BenchmarkService.MeasureNonSalaryPerEftsl)
                       ?.WeightedMean ?? 0;
        if (field == "Cph")
        {
            var staffPerEftsl = benchmarkData
                .FirstOrDefault(m => m.Measure == BenchmarkService.MeasureStaffSalaryPerEftsl)
                ?.WeightedMean ?? 0;
            var hoursPerEftsl = benchmarkData
                .FirstOrDefault(m => m.Measure == BenchmarkService.MeasureDeliveryHoursPerEftsl)
                ?.WeightedMean ?? 0;
            return hoursPerEftsl > 0 ? staffPerEftsl / hoursPerEftsl : 0;
        }
        return 0;
    }

    // Average CGS rate across all units with a FOE code set — used for the "effective value" display strip.
    private double FoeAverageCgsRate()
    {
        if (program is null || program.FoeCodeOptions.Count == 0) return 0;
        var rates = program.Units
            .Where(u => !string.IsNullOrWhiteSpace(u.FoeCodeDetailed))
            .Select(u => ResolveCanonicalFoe(u.FoeCodeDetailed)?.CgsRatePerEftsl ?? 0)
            .ToList();
        return rates.Count == 0 ? 0 : rates.Average();
    }

    // Matches a raw FOE code string (any separator format) to the canonical FoeCodeOptionDto
    // by comparing just the leading 6 numeric digits.
    private FoeCodeOptionDto? ResolveCanonicalFoe(string raw)
    {
        if (program is null || string.IsNullOrWhiteSpace(raw)) return null;
        var prefix = new string(raw.TakeWhile(char.IsDigit).ToArray());
        if (prefix.Length < 6) return null;
        prefix = prefix[..6];
        return program.FoeCodeOptions.FirstOrDefault(f => f.FoeCodeDetailed.StartsWith(prefix));
    }

    private bool HasSnowflakeSource => !string.IsNullOrWhiteSpace(program?.SourceDb);

    private IEnumerable<string> SourceOptions(string field)
    {
        // "Model" requires live Snowflake data — not available for manual scenarios.
        // Benchmark does not: it is sector data, which is exactly what a user with no
        // cost model of their own (a member without a loaded model, or the Preview)
        // has to work from.
        if (!HasSnowflakeSource)
            return field switch
            {
                "RevCgs" => ["Custom", "Cluster"],
                "Cph" or "Nfc" => ["Custom", "Benchmark"],
                _ => ["Custom"]
            };
        if (field == "RevCgs") return ["Custom", "Cluster", "Model"];
        if (field is "Cph" or "Nfc") return ["Custom", "Model", "Benchmark"];
        return ["Custom", "Model"];
    }

