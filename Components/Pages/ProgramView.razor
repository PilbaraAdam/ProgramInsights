        ? calculationResult!.CostResults.Average(r => r.TotalMarginPercent) : 0;

    private async Task GenerateBusinessCase()
    {
        if (program is null || calculationResult is null) return;
        isGenerating = true;
        cortexError = null;
        cortexResponse = "";
        try
        {
            cortexResponse = await CortexSvc.GenerateBusinessCaseAsync(program, calculationResult, cortexModel);
        }
        catch (Exception ex)
        {
            cortexError = $"Cortex error: {ex.Message}";
        }
        finally
        {
            isGenerating = false;
        }
    }

