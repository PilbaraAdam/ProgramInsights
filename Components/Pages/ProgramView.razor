@page "/program/{ProgramId:guid}"
@rendermode InteractiveServer
@using ProgramInsights.Services.Tenancy

<PageTitle>@(program?.Name ?? "Program") - Program Insights</PageTitle>

@if (isLoading)
{
    <div class="loading-container">
        <div class="loading-icon-wrap">
            <i class="fa-solid fa-chart-bar"></i>
        </div>
        <div class="loading-spinner"></div>
        <p class="loading-title">Loading Program</p>
        <p class="loading-sub">Fetching data, please wait…</p>
    </div>
}
else if (!string.IsNullOrWhiteSpace(loadError))
{
    <div class="content-container">
        <ul class="breadcrumb">
            <li><a href="/">Home</a></li>
            <li>Program</li>
        </ul>
        <div class="mapping-error">@loadError</div>
    </div>
}
else if (program is not null)
{
    <div class="content-container">
        <ul class="breadcrumb">
            <li><a href="/">Home</a></li>
            <li><a href="/">@program.ScenarioName</a></li>
            <li>@program.Name</li>
        </ul>
        @if (!string.IsNullOrWhiteSpace(statusMessage))
        {
            <span class="message-label">@statusMessage</span>
        }
        @if (!string.IsNullOrWhiteSpace(saveError))
        {
            <div class="mapping-error">@saveError</div>
        }
    </div>

    <div class="tabOuterContainer">
        <div class="tabContainer">
            <div class="tab">
                <div class="tab-content">
                    <div class="programDetails">
                        @if (activeTab != tabs[^1])
                        {
                            <button type="button" class="button2" @onclick="MoveToNextTab">
                                Next <i class="fa-solid fa-chevron-right"></i>
                            </button>
                        }
                    </div>

                    <div class="tabLeftSize">
                        @foreach (var tab in tabs)
                        {
                            <button type="button" class="tablinks @(activeTab == tab ? "active" : "")"
                                    @onclick="() => SetActiveTab(tab)">
                                <i class="@TabIcon(tab)"></i> @TabLabel(tab)
                            </button>
                        }
                    </div>
                </div>
            </div>

            @if (activeTab == "Details")
            {
                <div class="tabcontent" style="display:block;">
                    <div class="details-layout">

                        @* ── LEFT: Program details + Scenario ── *@
                        <div class="details-form-col">

                            @* Card 1 — Program details *@
                            <div class="details-card">
                                <div class="details-card-title">
                                    <i class="fa-solid fa-circle-info"></i> Program Details
                                </div>

                                @* Row 1: Name / Start Year / Profile *@
                                <div class="dcf-row">
                                    <div class="dcf-field dcf-field-grow">
                                        <label class="dcf-label">Name</label>
                                        <input type="text" class="textBoxStyle4" @bind="program.Name" maxlength="36" />
                                    </div>
                                    <div class="dcf-field dcf-field-sm">
                                        <label class="dcf-label">Start Year</label>
                                        <input type="number" class="textBoxStyle4" @bind="program.StartYear" />
                                    </div>
                                    @if (program.Profiles.Count > 0)
                                    {
                                        <div class="dcf-field dcf-field-sm">
                                            <label class="dcf-label">Default Profile</label>
                                            <select class="dropDownList1" @bind="program.Profile">
                                                @foreach (var p in program.Profiles)
                                                {
                                                    <option value="@p.Name">@p.Name</option>
                                                }
                                            </select>
                                        </div>
                                    }
                                </div>

                                @* Row 2: Description *@
                                <div class="dcf-row" style="margin-top:12px;">
                                    <div class="dcf-field dcf-field-grow">
                                        <label class="dcf-label">Description <span style="font-weight:400;color:#94a3b8;text-transform:none;letter-spacing:0;">(optional)</span></label>
                                        <textarea class="textBoxStyle3" rows="3" @bind="program.Description" maxlength="250"
                                                  placeholder="Add a brief program description…"></textarea>
                                    </div>
                                </div>

                                @* Row 3: Owner / Status *@
                                <div class="dcf-row" style="margin-top:12px;">
                                    <div class="dcf-field dcf-field-grow">
                                        <label class="dcf-label">Owner / Contact</label>
                                        <input type="text" class="textBoxStyle4" @bind="program.Owner"
                                               placeholder="e.g. Jane Smith" maxlength="100" />
                                    </div>
                                    <div class="dcf-field dcf-field-sm" style="flex:0 0 150px;">
                                        <label class="dcf-label">Program Status</label>
                                        <select class="dropDownList1" @bind="program.Status">
                                            <option value="Active">Active</option>
                                            <option value="Draft">Draft</option>
                                            <option value="Under Review">Under Review</option>
                                            <option value="Archived">Archived</option>
                                        </select>
                                    </div>
                                </div>

                                @* Row 4: Tags *@
                                <div style="margin-top:12px;">
                                    <label class="dcf-label">Tags</label>
                                    <div class="tag-pills" style="margin-top:6px;">
                                        @foreach (var tag in ParsedTags)
                                        {
                                            var capturedTag = tag;
                                            <span class="tag-pill">
                                                @capturedTag
                                                <button type="button" @onclick="() => RemoveTag(capturedTag)" title="Remove">×</button>
                                            </span>
                                        }
                                        <div class="tag-add-row">
                                            <input type="text" class="textBoxStyle4" style="width:160px;padding:4px 8px;font-size:12px;"
                                                   placeholder="Add a tag…" @bind="newTagInput" @bind:event="oninput"
                                                   @onkeydown="OnTagInputKeyDown" />
                                            <button type="button" class="tag-add-btn" @onclick="AddTag">+ Add tag</button>
                                        </div>
                                    </div>
                                </div>

                                @* Info row *@
                                <div class="dcf-info-row" style="margin-top:14px;">
                                    <i class="fa-solid fa-calendar-days"></i>
                                    @program.Settings.Count projection year@(program.Settings.Count == 1 ? "" : "s")
                                    &nbsp;·&nbsp; @program.StartYear – @(program.StartYear + program.Settings.Count - 1)
                                </div>
                            </div>

                            @* Card 2 — Scenario *@
                            <div class="details-card">
                                <div class="details-card-title">
                                    <i class="fa-solid fa-database"></i> Scenario
                                </div>
                                <div class="quickstat-row">
                                    <span class="quickstat-label">Name</span>
                                    <span class="quickstat-value">@program.ScenarioName</span>
                                </div>
                                <div class="quickstat-row">
                                    <span class="quickstat-label">Source</span>
                                    <span class="quickstat-value">
                                        @if (!string.IsNullOrWhiteSpace(program.SourceDb))
                                        {
                                            <span class="scenario-sf-badge">
                                                <i class="fa-solid fa-database"></i> @program.SourceDb
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="source-manual-tag">
                                                <i class="fa-solid fa-file-pen"></i> Manual
                                            </span>
                                        }
                                    </span>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(program.InsightsModel))
                                {
                                    <div class="quickstat-row">
                                        <span class="quickstat-label">Model</span>
                                        <span class="quickstat-value" style="font-size:12px;">@program.InsightsModel</span>
                                    </div>
                                }
                                @if (program.ScenarioSaveDate.HasValue)
                                {
                                    <div class="quickstat-row">
                                        <span class="quickstat-label">Data updated</span>
                                        <span class="quickstat-value" style="font-size:12px;">@FormatDate(program.ScenarioSaveDate)</span>
                                    </div>
                                }
                                @if (!string.IsNullOrWhiteSpace(program.SourceDb))
                                {
                                    var schoolCount = Schools.Count();
                                    var courseCount = program.ModelValues.Select(v => v.CourseName).Distinct().Count();
                                    var unitCount = program.UnitOptions.Count;
                                    var projYears = program.Settings.Count;
                                    <div class="scenario-stats-grid">
                                        <div class="scenario-stat-tile">
                                            <div class="scenario-stat-value">@courseCount</div>
                                            <div class="scenario-stat-label">Courses</div>
                                        </div>
                                        <div class="scenario-stat-tile">
                                            <div class="scenario-stat-value">@unitCount</div>
                                            <div class="scenario-stat-label">Units</div>
                                        </div>
                                        @if (schoolCount > 0)
                                        {
                                            <div class="scenario-stat-tile">
                                                <div class="scenario-stat-value">@schoolCount</div>
                                                <div class="scenario-stat-label">Schools</div>
                                            </div>
                                        }
                                        <div class="scenario-stat-tile">
                                            <div class="scenario-stat-value">@projYears <span style="font-size:14px;font-weight:500;">yrs</span></div>
                                            <div class="scenario-stat-label">Projection</div>
                                        </div>
                                    </div>
                                    <a href="/scenario/@program.ScenarioId/mapping?db=@Uri.EscapeDataString(program.SourceDb)"
                                       class="button2 mapping-link-btn" style="width:100%;justify-content:center;display:flex;">
                                        <i class="fa-solid fa-diagram-project"></i> Edit data mapping
                                    </a>
                                }
                            </div>

                            <div class="tab-footer-actions">
                                <button type="button" class="button2" @onclick="MoveToNextTab">
                                    Next: Input Data <i class="fa-solid fa-chevron-right"></i>
                                </button>
                            </div>
                        </div>

                        @* ── RIGHT: workflow sidebar ── *@
                        <div class="details-sidebar-col">

                            @* Setup checklist *@
                            @{
                                var stepsComplete = SetupStepsComplete;
                                var pct = (stepsComplete * 100) / 4;
                            }
                            <div class="details-checklist">
                                <div class="details-checklist-title">Setup Checklist</div>
                                <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px;">
                                    <span style="font-size:12px;color:#374151;">@stepsComplete of 4 steps complete</span>
                                    <span style="font-size:12px;font-weight:700;color:@(pct == 100 ? "#16a34a" : "#d97706");">@pct%</span>
                                </div>
                                <div class="checklist-progress-bar">
                                    <div class="checklist-progress-fill" style="width:@pct%;background:@(pct == 100 ? "#16a34a" : "#d97706");"></div>
                                </div>

                                @* Step: Input data *@
                                <div class="checklist-v2-item">
                                    <div class="checklist-v2-icon @(InputDataReady ? "ok" : "warn")">
                                        <i class="@(InputDataReady ? "fa-solid fa-check" : "fa-solid fa-pen")"></i>
                                    </div>
                                    <div>
                                        <div class="checklist-v2-title">Input data</div>
                                        <div class="checklist-v2-desc">@(InputDataReady ? "EFTSL values entered" : "No EFTSL entered")</div>
                                        @if (!InputDataReady)
                                        {
                                            <button type="button" class="checklist-v2-link" @onclick='() => SetActiveTab("InputData")'>Go to Input Data →</button>
                                        }
                                    </div>
                                </div>

                                @* Step: Units *@
                                <div class="checklist-v2-item">
                                    <div class="checklist-v2-icon @(UnitsReady ? "ok" : "warn")">
                                        <i class="@(UnitsReady ? "fa-solid fa-check" : "fa-solid fa-pen")"></i>
                                    </div>
                                    <div>
                                        <div class="checklist-v2-title">Units</div>
                                        <div class="checklist-v2-desc">@(UnitsReady ? $"{program.Units.Count} unit{(program.Units.Count == 1 ? "" : "s")} configured" : "No units added")</div>
                                        @if (!UnitsReady)
                                        {
                                            <button type="button" class="checklist-v2-link" @onclick='() => SetActiveTab("Units")'>Go to Units →</button>
                                        }
                                    </div>
                                </div>

                                @* Step: Cost & Revenue *@
                                <div class="checklist-v2-item">
                                    <div class="checklist-v2-icon @(CostRevenueReady ? "ok" : "warn")">
                                        <i class="@(CostRevenueReady ? "fa-solid fa-check" : "fa-solid fa-pen")"></i>
                                    </div>
                                    <div>
                                        <div class="checklist-v2-title">Cost & revenue</div>
                                        <div class="checklist-v2-desc">@(CostRevenueReady ? "Values set" : "Missing CPH or NFC")</div>
                                        @if (!CostRevenueReady)
                                        {
                                            <button type="button" class="checklist-v2-link" @onclick='() => SetActiveTab("CostRevenue")'>Go to Cost & Revenue →</button>
                                        }
                                    </div>
                                </div>

                                @* Step: Run calculation *@
                                <div class="checklist-v2-item">
                                    <div class="checklist-v2-icon @(calculationResult is not null && !calculationIsStale ? "ok" : "pending")">
                                        <i class="@(calculationResult is not null && !calculationIsStale ? "fa-solid fa-check" : "fa-regular fa-circle")"></i>
                                    </div>
                                    <div>
                                        <div class="checklist-v2-title">Run calculation</div>
                                        <div class="checklist-v2-desc">
                                            @if (calculationResult is not null && !calculationIsStale) { <span>Results available</span> }
                                            else if (calculationIsStale) { <span>Results are stale</span> }
                                            else { <span>Not yet run</span> }
                                        </div>
                                        @if (calculationResult is null || calculationIsStale)
                                        {
                                            <button type="button" class="checklist-v2-link" @onclick='() => SetActiveTab("Results")'>Go to Results →</button>
                                        }
                                    </div>
                                </div>

                            </div>

                            @* Suggested next step *@
                            @{
                                var nextStep = GetSuggestedNextStep();
                            }
                            <div class="suggested-step-card">
                                <div class="suggested-step-title">
                                    <i class="fa-solid fa-circle-arrow-right"></i> Suggested next step
                                </div>
                                <p class="suggested-step-desc">@nextStep.Description</p>
                                <button type="button" class="button1 suggested-step-btn"
                                        @onclick="() => SetActiveTab(nextStep.TabTarget)">
                                    <i class="fa-solid fa-play"></i> @nextStep.ButtonText
                                </button>
                            </div>

                        </div>
                    </div>
                </div>
            }

            @if (activeTab == "InputData")
            {
                <div class="tabcontent" style="display:block;">
                    <div class="fixedTableWidth">
                    <div class="tab-section-header">
                        <h3 class="tab-section-title">Enrolment &amp; Cost Projections</h3>
                        <p class="tab-section-desc">Enter commencing EFTSL, fixed costs, and CPI adjustments for each projection year.</p>
                    </div>
                    <div class="input-data-scroll-wrapper">
                        <table class="input-data-table">
                            <thead>
                                <tr>
                                    <th>Year</th>
                                    @foreach (var setting in program.Settings)
                                    {
                                        <th>@(program.StartYear + setting.Year)</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @InputRow("CGS EFTSL", "enrolment-row", setting => setting.CgsEftsl, (setting, value) => setting.CgsEftsl = value)
                                @InputRow("Domestic EFTSL", "enrolment-row", setting => setting.DomesticEftsl, (setting, value) => setting.DomesticEftsl = value)
                                @InputRow("International EFTSL", "enrolment-row", setting => setting.InternationalEftsl, (setting, value) => setting.InternationalEftsl = value)
                                @InputRow("Fixed Costs ($)", "cost-row group-start", setting => setting.FixedExpense, (setting, value) => setting.FixedExpense = value)
                                @InputRow("Revenue CPI (%)", "cpi-row group-start", setting => setting.RevenueCpi, (setting, value) => setting.RevenueCpi = value)
                                @InputRow("Expense CPI (%)", "cpi-row", setting => setting.ExpenseCpi, (setting, value) => setting.ExpenseCpi = value)
                            </tbody>
                        </table>
                    </div>

                    <div class="tab-footer-actions" style="margin-top:16px;">
                        <button type="button" class="button2" @onclick="AddProjectionYear">+ Add Year</button>
                        <button type="button" class="button2" @onclick="RemoveProjectionYear" disabled="@(program.Settings.Count <= 1)">- Remove Year</button>
                        <span style="flex:1;"></span>
                        <button type="button" class="button2" @onclick="MoveToNextTab">
                            Next: Units <i class="fa-solid fa-chevron-right"></i>
                        </button>
                    </div>
                    </div> @* end fixedTableWidth *@
                </div>
            }

            @if (activeTab == "Units")
            {
                <div class="tabcontent" style="display:block;">
                    <div class="fixedTableWidth">
                        <div class="tab-section-header">
                            <h3 class="tab-section-title">Units &amp; Profiles</h3>
                            <p class="tab-section-desc">Assign units and teaching profiles for each year of the degree. All listed units are treated as core — every student attends every unit.</p>
                        </div>

                        <div id="degreeYearsContainer">
                            @for (var year = 1; year <= DegreeYearCount; year++)
                            {
                                var capturedYear = year;
                                var unitsForYear = program.Units.Where(u => u.ProgramYear == capturedYear).ToList();
                                <div class="degree-year-section">
                                    <div class="degree-year-header">
                                        <span class="dy-header-left">
                                            <i class="fa-solid fa-calendar-days"></i>
                                            <span class="dy-year-label">Year @capturedYear</span>
                                            <span class="dy-unit-count">@unitsForYear.Count @(unitsForYear.Count == 1 ? "unit" : "units")</span>
                                        </span>
                                    </div>
                                    <div class="degree-year-body">
                                        <table class="profiles-table">
                                            <thead>
                                                <tr>
                                                    <th>Unit</th>
                                                    <th>Profile</th>
                                                    <th></th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @if (unitsForYear.Count == 0)
                                                {
                                                    <tr class="no-units-row">
                                                        <td colspan="3" class="no-units-msg">No units yet.</td>
                                                    </tr>
                                                }
                                                @foreach (var unit in unitsForYear)
                                                {
                                                    <tr>
                                                        <td class="unit-name-cell">
                                                            @if (!program.UnitOptions.Any(o => o.Name == unit.Unit))
                                                            {
                                                                <span class="new-unit-pill">New</span>
                                                            }
                                                            @unit.Unit
                                                        </td>
                                                        <td class="profile-name-cell">
                                                            @unit.Profile
                                                        </td>
                                                        <td class="action-cell">
                                                            <button type="button" class="row-action-btn"
                                                                    title="Edit" @onclick="() => OpenUnitPicker(capturedYear, unit)">
                                                                <i class="fa-solid fa-pen"></i>
                                                            </button>
                                                            <button type="button" class="row-action-btn row-action-remove"
                                                                    title="Remove" @onclick="() => RemoveUnit(unit)">
                                                                <i class="fa-solid fa-trash"></i>
                                                            </button>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                        <div class="dy-footer">
                                            <button type="button" class="button4" @onclick="() => OpenUnitPicker(capturedYear)">
                                                <i class="fa-solid fa-plus"></i> Add Unit
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>

                        <div class="tab-footer-actions" style="margin-top:16px;">
                            <button type="button" class="button2" @onclick="AddDegreeYear">
                                <i class="fa-solid fa-plus"></i> Add Degree Year
                            </button>
                            <button type="button" class="button2" @onclick="RemoveDegreeYear" disabled="@(DegreeYearCount <= 1)">
                                <i class="fa-solid fa-trash"></i> Remove Last Year
                            </button>
                            <span style="flex:1;"></span>
                            <button type="button" class="button2" @onclick="MoveToNextTab">
                                Next: Cost & Revenue <i class="fa-solid fa-chevron-right"></i>
                            </button>
                        </div>
                    </div>
                </div>
            }

            @if (activeTab == "CostRevenue")
            {
                <div class="tabcontent" style="display:block;">
                    <div class="fixedTableWidth">
                        <div class="tab-section-header">
                            <h3 class="tab-section-title">Cost &amp; Revenue</h3>
                            <p class="tab-section-desc">Set the faculty cost per hour, non-faculty cost, and revenue rates per EFTSL. Use model values from Snowflake data or enter custom figures.</p>
                        </div>
                        <div class="cr-layout @(HasSnowflakeSource ? "" : "cr-layout-manual")">

                            @* Model reference table at the top — Snowflake scenarios only *@
                            @if (HasSnowflakeSource)
                            {
                                <div class="cr-model-panel">
                                    <p class="cr-panel-title">Model Reference Data</p>
                                    <p style="font-size:12px;color:#64748b;margin:0 0 10px;">Click a row to copy its values into the settings below.</p>
                                    <div style="display:flex;gap:8px;margin-bottom:10px;flex-wrap:wrap;">
                                        <select class="dropDownList1" @bind="program.SchoolSelect">
                                            <option value="">All Schools</option>
                                            @foreach (var school in Schools)
                                            {
                                                <option value="@school">@school</option>
                                            }
                                        </select>
                                        <select class="dropDownList1" @bind="program.CourseSelect">
                                            <option value="">All Courses</option>
                                            @foreach (var course in Courses)
                                            {
                                                <option value="@course">@course</option>
                                            }
                                        </select>
                                    </div>
                                    <table class="tableStyle2 cr-model-table">
                                        <thead>
                                            <tr>
                                                <th>Career</th>
                                                <th>CPH</th>
                                                <th>NFC / EFTSL</th>
                                                <th>Rev Dom</th>
                                                <th>Rev Int</th>
                                                <th>Rev CGS</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (!ModelValueSummaries.Any())
                                            {
                                                <tr><td colspan="6" style="color:#94a3b8;font-size:12px;text-align:center;padding:16px;">No model data available.</td></tr>
                                            }
                                            @foreach (var value in ModelValueSummaries)
                                            {
                                                <tr class="selectable-row @(program.CareerSelect == value.Career ? "scenario-selected" : "")"
                                                    @onclick="() => SelectModelValue(value)">
                                                    <td><span class="custom-link">@value.Career</span></td>
                                                    <td>@FormatNumber(value.CostPerHour)</td>
                                                    <td>@FormatNumber(value.NonCostPerEftsl)</td>
                                                    <td>@FormatNumber(value.RevDomPerEftsl)</td>
                                                    <td>@FormatNumber(value.RevIntPerEftsl)</td>
                                                    <td>@FormatNumber(value.RevCgsPerEftsl)</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }

                            <!-- Editor cards below — Revenue row then Cost row -->
                            <div class="cr-editor-panel">
                                <div class="cr-section">
                                    <div class="cr-section-header">
                                        <i class="fa-solid fa-arrow-trend-up"></i> Revenue
                                    </div>
                                    <div class="cr-cards-row">
                                        @CrEditorCard("CGS Revenue / EFTSL", "RevCgs")
                                        @CrEditorCard("Domestic Revenue / EFTSL", "RevDom")
                                        @CrEditorCard("International Revenue / EFTSL", "RevInt")
                                    </div>
                                </div>
                                <div class="cr-section">
                                    <div class="cr-section-header">
                                        <i class="fa-solid fa-arrow-trend-down"></i> Cost
                                    </div>
                                    <div class="cr-cards-row cr-cards-row-2">
                                        @CrEditorCard("Faculty Cost / Hour", "Cph")
                                        @CrEditorCard("Non-Faculty Cost / EFTSL", "Nfc")
                                    </div>
                                </div>
                            </div>

                        </div>

                        <div class="tab-footer-actions" style="margin-top:20px;">
                            <button type="button" class="button2" @onclick="MoveToNextTab">
                                Next: Calculate <i class="fa-solid fa-chevron-right"></i>
                            </button>
                        </div>
                    </div>
                </div>
            }

            @if (activeTab == "Results")
            {
                <div class="tabcontent" style="display:block;">
                    <div class="fixedTableWidth">
                        <div class="tab-section-header">
                            <h3 class="tab-section-title">Results</h3>
                            <p class="tab-section-desc">Year-by-year projection of EFTSL ramp-up, teaching hours, revenue, cost, and margin across all cohorts.</p>
                        </div>

                        @if (isCalculating)
                        {
                            <div class="calc-loading">
                                <div class="calc-loading-spinner"></div>
                                <div class="calc-loading-title">Calculating…</div>
                                <p class="calc-loading-desc">Projecting EFTSL ramp-up, revenue, cost, and margin across all cohorts and years.</p>
                            </div>
                        }
                        else
                        {
                            <div class="results-toolbar">
                                <button type="button" class="@(calculationResult is null || calculationIsStale ? "button1" : "button2")" @onclick="RunCalculation">
                                    <i class="fa-solid fa-calculator"></i> @(calculationResult is null ? "Run Calculation" : "Recalculate")
                                </button>
                                <button type="button" class="button2" @onclick="DownloadExcel" disabled="@(exportBytes is null)">
                                    <i class="fa-solid fa-file-excel"></i> Export to Excel
                                </button>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(calcError))
                            {
                                <div class="mapping-error">@calcError</div>
                            }

                            @if (calculationResult is null)
                            {
                                <div class="calc-prereq">
                                    <div class="calc-prereq-header">
                                        <i class="fa-solid fa-circle-info calc-prereq-icon"></i>
                                        <div>
                                            <div class="calc-prereq-title">Ready to calculate?</div>
                                            <p class="calc-prereq-subtitle">The calculation projects EFTSL cohort ramp-up and produces year-by-year revenue, cost, and margin figures based on your inputs below.</p>
                                        </div>
                                    </div>
                                    <div class="calc-prereq-checklist">
                                        <div class="checklist-item @(InputDataReady ? "check-ok" : "check-warn")">
                                            <i class="@(InputDataReady ? "fa-solid fa-circle-check" : "fa-solid fa-circle-exclamation")"></i>
                                            <div>
                                                <span class="calc-check-label">Input Data</span>
                                                <span class="calc-check-detail">@(InputDataReady ? "EFTSL values entered" : "No EFTSL values — go to Input Data tab")</span>
                                            </div>
                                        </div>
                                        <div class="checklist-item @(UnitsReady ? "check-ok" : "check-warn")">
                                            <i class="@(UnitsReady ? "fa-solid fa-circle-check" : "fa-solid fa-circle-exclamation")"></i>
                                            <div>
                                                <span class="calc-check-label">Units</span>
                                                <span class="calc-check-detail">@(UnitsReady ? $"{program!.Units.Count} unit{(program!.Units.Count == 1 ? "" : "s")} configured" : "No units added — go to Units tab")</span>
                                            </div>
                                        </div>
                                        <div class="checklist-item @(CostRevenueReady ? "check-ok" : "check-warn")">
                                            <i class="@(CostRevenueReady ? "fa-solid fa-circle-check" : "fa-solid fa-circle-exclamation")"></i>
                                            <div>
                                                <span class="calc-check-label">Cost &amp; Revenue</span>
                                                <span class="calc-check-detail">@(CostRevenueReady ? "CPH and NFC values set" : "Missing CPH or NFC — go to Cost & Revenue tab")</span>
                                            </div>
                                        </div>
                                    </div>
                                    <button type="button" class="button1 calc-prereq-btn" @onclick="RunCalculation">
                                        <i class="fa-solid fa-calculator"></i> Run Calculation
                                    </button>
                                </div>
                            }
                            else
                            {
                                @if (calculationIsStale)
                                {
                                    <div class="calc-stale-banner">
                                        <i class="fa-solid fa-triangle-exclamation"></i>
                                        <span>Inputs have changed since the last calculation — results below may be out of date.</span>
                                        <button type="button" class="calc-stale-btn" @onclick="RunCalculation">Recalculate</button>
                                    </div>
                                }
                                <!-- Year summary cards -->
                            <div class="results-cards">
                                @foreach (var row in calculationResult.CostResults)
                                {
                                    <div class="result-card">
                                        <div class="result-card-year">@row.CalendarYear</div>
                                        <div class="result-card-row">
                                            <span class="result-card-label">Total EFTSL</span>
                                            <span class="result-card-value">@FormatNumber(row.TotalEftsl)</span>
                                        </div>
                                        <div class="result-card-row">
                                            <span class="result-card-label">Teaching Hours</span>
                                            <span class="result-card-value">@FormatNumber(row.TotalTeachingHours)</span>
                                        </div>
                                        <div class="result-card-row">
                                            <span class="result-card-label">Revenue</span>
                                            <span class="result-card-value">@FormatCurrency(row.FacultyRevenue)</span>
                                        </div>
                                        <div class="result-card-row">
                                            <span class="result-card-label">Total Cost</span>
                                            <span class="result-card-value">@FormatCurrency(row.FacultyCost + row.NonFacultyCost)</span>
                                        </div>
                                        <div class="result-card-row">
                                            <span class="result-card-label">Margin</span>
                                            <span class="result-card-value @(row.TotalMargin >= 0 ? "positive" : "negative")">@FormatCurrency(row.TotalMargin)</span>
                                        </div>
                                        <div class="result-card-row">
                                            <span class="result-card-label">Margin %</span>
                                            <span class="result-card-value @(row.TotalMarginPercent >= 0 ? "positive" : "negative")">@FormatPercent(row.TotalMarginPercent)</span>
                                        </div>
                                    </div>
                                }
                            </div>

                            <!-- Charts -->
                            <div class="charts-row">
                                <div class="chart-card">
                                    <div class="chart-card-title">Revenue vs Cost</div>
                                    <div class="chart-canvas-wrap">
                                        <canvas id="costRevenueChart"></canvas>
                                    </div>
                                </div>
                                <div class="chart-card">
                                    <div class="chart-card-title">EFTSL Ramp-up by Cohort</div>
                                    <div class="chart-canvas-wrap">
                                        <canvas id="eftslRampupChart"></canvas>
                                    </div>
                                </div>
                            </div>

                            <!-- EFTSL ramp-up triangle table -->
                            <h3 class="grid-header">EFTSL by Forecast Year and Cohort</h3>
                            <div style="overflow-x:auto;margin-bottom:28px;">
                                <table class="rampup-table">
                                    <thead>
                                        <tr>
                                            <th>Forecast Year</th>
                                            @foreach (var ci in RampCohorts)
                                            {
                                                <th>Intake @(program!.StartYear + ci)</th>
                                            }
                                            <th>Total</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var costRow in calculationResult.CostResults)
                                        {
                                            <tr>
                                                <td><strong>@costRow.CalendarYear</strong></td>
                                                @foreach (var ci in RampCohorts)
                                                {
                                                    var cohortFirstH = calculationResult.HourResults
                                                        .FirstOrDefault(h => h.ForecastYearIndex == costRow.YearIndex && h.CohortStartYearIndex == ci);
                                                    var eftsl = cohortFirstH is null ? 0 : cohortFirstH.DomesticEftsl + cohortFirstH.InternationalEftsl + cohortFirstH.CgsEftsl;
                                                    var sy = costRow.YearIndex - ci + 1;
                                                    <td>
                                                        @if (eftsl > 0)
                                                        {
                                                            <span>@FormatNumber(eftsl) <span style="font-size:11px;color:#94a3b8;">(Yr@sy)</span></span>
                                                        }
                                                        else
                                                        {
                                                            <span class="rampup-empty">—</span>
                                                        }
                                                    </td>
                                                }
                                                <td class="rampup-total">@FormatNumber(costRow.TotalEftsl)</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>

                            <!-- Collapsible cohort detail -->
                            <h3 class="grid-header">Unit Detail</h3>
                            @foreach (var forecastGroup in calculationResult.HourResults.GroupBy(h => h.ForecastYearIndex).OrderBy(g => g.Key))
                            {
                                var fyi = forecastGroup.Key;
                                var costRow2 = calculationResult.CostResults.FirstOrDefault(c => c.YearIndex == fyi);
                                var isOpen = expandedYears.Contains(fyi);
                                <div class="detail-section">
                                    <button type="button" class="detail-section-toggle @(isOpen ? "open" : "")"
                                            @onclick="() => ToggleYear(fyi)">
                                        <i class="fa-solid fa-chevron-right toggle-icon"></i>
                                        <span>@(program!.StartYear + fyi)</span>
                                        <span style="font-weight:400;color:#64748b;font-size:13px;">
                                            &mdash; @FormatNumber(costRow2?.TotalEftsl ?? 0) EFTSL &nbsp;·&nbsp;
                                            @FormatCurrency(costRow2?.FacultyRevenue ?? 0) revenue &nbsp;·&nbsp;
                                            @FormatCurrency(costRow2?.TotalMargin ?? 0) margin
                                        </span>
                                    </button>
                                    @if (isOpen)
                                    {
                                        <div class="detail-section-body">
                                            @foreach (var cohortGroup in forecastGroup.GroupBy(h => h.CohortStartYearIndex).OrderBy(g => g.Key))
                                            {
                                                var studyYear = cohortGroup.First().StudyYear;
                                                var firstCohortH = cohortGroup.First();
                                                var cohortEftsl = firstCohortH.DomesticEftsl + firstCohortH.InternationalEftsl + firstCohortH.CgsEftsl;
                                                <div class="cohort-group-header">
                                                    Intake @(program!.StartYear + cohortGroup.Key) &mdash; Study Year @studyYear &mdash; @FormatNumber(cohortEftsl) EFTSL
                                                </div>
                                                <table class="tableStyleResults textAlignRight">
                                                    <thead>
                                                        <tr>
                                                            <th>Unit</th>
                                                            <th>Profile</th>
                                                            <th>Dom EFTSL</th>
                                                            <th>Int EFTSL</th>
                                                            <th>CGS EFTSL</th>
                                                            <th>Students / Unit</th>
                                                            <th>New Unit Hours</th>
                                                            <th>Student Hours</th>
                                                            <th>Total Hours</th>
                                                            <th>Revenue</th>
                                                            <th>Faculty Cost</th>
                                                            <th>Non-Fac Cost</th>
                                                            <th>Total Cost</th>
                                                            <th>Margin</th>
                                                            <th>Margin %</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var hour in cohortGroup)
                                                        {
                                                            <tr>
                                                                <td class="textAlignLeft">@hour.Unit</td>
                                                                <td class="textAlignLeft">@hour.Profile</td>
                                                                <td>@FormatNumber(hour.DomesticEftsl)</td>
                                                                <td>@FormatNumber(hour.InternationalEftsl)</td>
                                                                <td>@FormatNumber(hour.CgsEftsl)</td>
                                                                <td>@FormatNumber(hour.StudentsPerUnit)</td>
                                                                <td>@FormatNumber(hour.NewUnitHours)</td>
                                                                <td>@FormatNumber(hour.StudentHours)</td>
                                                                <td>@FormatNumber(hour.TotalHours)</td>
                                                                <td>@FormatCurrency(hour.FacultyRevenue)</td>
                                                                <td>@FormatCurrency(hour.FacultyCost)</td>
                                                                <td>@FormatCurrency(hour.NonFacultyCost)</td>
                                                                <td>@FormatCurrency(hour.TotalCost)</td>
                                                                <td class="@(hour.Margin >= 0 ? "positive" : "negative")">@FormatCurrency(hour.Margin)</td>
                                                                <td class="@(hour.MarginPercent >= 0 ? "positive" : "negative")">@FormatPercent(hour.MarginPercent)</td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                            }   @* end else (calculationResult is not null) *@
                        }   @* end else (not calculating) *@
                    </div>
                </div>
            }

            @if (activeTab == "BreakEven")
            {
                <div class="tabcontent" style="display:block;">
                    <div class="fixedTableWidth">
                        <div class="tab-section-header">
                            <h3 class="tab-section-title">Breakeven Analysis</h3>
                            <p class="tab-section-desc">At what enrolment does this program cover its costs? Breakeven EFTSL is derived from the contribution margin — revenue minus variable costs per EFTSL — over the fixed expense floor.</p>
                        </div>

                        @if (calculationResult is null)
                        {
                            <div class="calc-prereq">
                                <div class="calc-prereq-header">
                                    <i class="fa-solid fa-circle-info calc-prereq-icon"></i>
                                    <div>
                                        <div class="calc-prereq-title">Run a calculation first</div>
                                        <p class="calc-prereq-subtitle">Breakeven analysis is generated automatically when you run the calculation on the Results tab.</p>
                                    </div>
                                </div>
                                <button type="button" class="button1 calc-prereq-btn" @onclick='() => SetActiveTab("Results")'>
                                    <i class="fa-solid fa-arrow-right"></i> Go to Results
                                </button>
                            </div>
                        }
                        else
                        {
                            @if (calculationIsStale)
                            {
                                <div class="calc-stale-banner">
                                    <i class="fa-solid fa-triangle-exclamation"></i>
                                    <span>Inputs have changed — breakeven figures may be out of date.</span>
                                    <button type="button" class="calc-stale-btn" @onclick='() => SetActiveTab("Results")'>Recalculate</button>
                                </div>
                            }

                            <!-- Year summary cards -->
                            <div class="results-cards">
                                @foreach (var be in calculationResult.BreakevenResults)
                                {
                                    var chipClass = !be.IsBreakevenPossible ? "impossible"
                                        : be.EftslSurplus >= 0 ? "above" : "below";
                                    var chipIcon = !be.IsBreakevenPossible ? "fa-triangle-exclamation"
                                        : be.EftslSurplus >= 0 ? "fa-circle-check" : "fa-circle-xmark";
                                    var chipLabel = !be.IsBreakevenPossible ? "Not possible"
                                        : be.EftslSurplus >= 0 ? "Above breakeven" : "Below breakeven";
                                    var progressPct = be.IsBreakevenPossible && be.BreakevenEftsl > 0
                                        ? Math.Min(100, be.ProjectedEftsl / be.BreakevenEftsl * 100) : 0;

                                    <div class="result-card">
                                        <div class="result-card-year">@be.CalendarYear</div>
                                        <span class="be-status-chip @chipClass">
                                            <i class="fa-solid @chipIcon"></i> @chipLabel
                                        </span>
                                        <div class="be-progress-wrap">
                                            <div class="be-progress-bar @chipClass" style="width:@(progressPct.ToString("F1"))%"></div>
                                        </div>
                                        <div class="result-card-row">
                                            <span class="result-card-label">Breakeven EFTSL</span>
                                            <span class="result-card-value">
                                                @(be.IsBreakevenPossible ? FormatNumber(be.BreakevenEftsl) : "—")
                                            </span>
                                        </div>
                                        <div class="result-card-row">
                                            <span class="result-card-label">Projected EFTSL</span>
                                            <span class="result-card-value">@FormatNumber(be.ProjectedEftsl)</span>
                                        </div>
                                        <div class="result-card-row">
                                            <span class="result-card-label">Surplus / Deficit</span>
                                            <span class="result-card-value @(be.EftslSurplus >= 0 ? "positive" : "negative")">
                                                @(be.IsBreakevenPossible ? (be.EftslSurplus >= 0 ? "+" : "") + FormatNumber(be.EftslSurplus) : "—")
                                            </span>
                                        </div>
                                        <div class="result-card-row">
                                            <span class="result-card-label">vs Breakeven</span>
                                            <span class="result-card-value @(be.SurplusPercent >= 0 ? "positive" : "negative")">
                                                @(be.IsBreakevenPossible ? FormatPercent(be.SurplusPercent) : "—")
                                            </span>
                                        </div>
                                    </div>
                                }
                            </div>

                            <!-- CVP chart with year selector -->
                            <div class="be-chart-card">
                                <div class="be-chart-title">Cost vs Revenue by EFTSL — where the lines cross is your breakeven</div>
                                <div class="be-year-tabs">
                                    @for (var yi = 0; yi < calculationResult.BreakevenResults.Count; yi++)
                                    {
                                        var capturedYi = yi;
                                        var beRow = calculationResult.BreakevenResults[yi];
                                        <button type="button"
                                                class="be-year-tab @(selectedBreakevenYearIndex == capturedYi ? "active" : "")"
                                                @onclick="() => SelectBreakevenYear(capturedYi)">
                                            @beRow.CalendarYear
                                        </button>
                                    }
                                </div>
                                <div class="be-chart-wrap">
                                    <canvas id="breakevenChart"></canvas>
                                </div>
                            </div>

                            <!-- Contribution margin detail table -->
                            <h3 class="grid-header">Contribution Margin Detail</h3>
                            <div style="overflow-x:auto; margin-bottom:28px;">
                                <table class="be-table">
                                    <thead>
                                        <tr>
                                            <th>Year</th>
                                            <th>Rev / EFTSL</th>
                                            <th>Var Cost / EFTSL</th>
                                            <th>CM / EFTSL</th>
                                            <th>Fixed Cost</th>
                                            <th>Breakeven EFTSL</th>
                                            <th>Projected EFTSL</th>
                                            <th>Surplus / Deficit</th>
                                            <th>vs Breakeven</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var be in calculationResult.BreakevenResults)
                                        {
                                            <tr>
                                                <td>@be.CalendarYear</td>
                                                <td>@FormatCurrency(be.RevenuePerEftsl)</td>
                                                <td>@FormatCurrency(be.VariableCostPerEftsl)</td>
                                                <td>@FormatCurrency(be.ContributionMarginPerEftsl)</td>
                                                <td>@FormatCurrency(be.FixedCost)</td>
                                                <td>@(be.IsBreakevenPossible ? FormatNumber(be.BreakevenEftsl) : "—")</td>
                                                <td>@FormatNumber(be.ProjectedEftsl)</td>
                                                <td class="@(be.EftslSurplus >= 0 ? "be-surplus-cell" : "be-deficit-cell")">
                                                    @(be.IsBreakevenPossible ? (be.EftslSurplus >= 0 ? "+" : "") + FormatNumber(be.EftslSurplus) : "—")
                                                </td>
                                                <td class="@(be.SurplusPercent >= 0 ? "be-surplus-cell" : "be-deficit-cell")">
                                                    @(be.IsBreakevenPossible ? FormatPercent(be.SurplusPercent) : "—")
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
            }

            @if (activeTab == "Compare")
            {
                <div class="tabcontent" style="display:block;">
                    <div class="fixedTableWidth">
                        <div class="tab-section-header">
                            <h3 class="tab-section-title">Compare</h3>
                            <p class="tab-section-desc">Program comparison will be wired after calculation results are available in Blazor state.</p>
                        </div>
                    </div>
                </div>
            }

            @if (activeTab == "Benchmark")
            {
                <div class="tabcontent" style="display:block;">
                    <div class="fixedTableWidth">
                        <div class="tab-section-header">
                            <h3 class="tab-section-title">Benchmark</h3>
                            <p class="tab-section-desc">Set your peer-group filters and see how this program compares against the sector. Run the calculation first to see results.</p>
                        </div>

                        @* ── Peer-group filter panel — always visible ── *@
                        <div class="bm-filter-panel" style="margin-bottom:20px;">
                            <p class="cr-panel-title" style="margin:0 0 10px;">Peer Group Filters</p>
                            @if (isLoadingBenchmarkFilters)
                            {
                                <div style="font-size:13px;color:#64748b;"><i class="fa-solid fa-spinner fa-spin"></i> Loading filter options…</div>
                            }
                            else
                            {
                                <div class="bm-filter-grid">
                                    <div class="bm-filter-field">
                                        <label class="bm-filter-label">Degree Level</label>
                                        <select class="dropDownList1"
                                                @bind="program.BmDegreeLevel"
                                                @bind:after="OnBenchmarkFilterChanged">
                                            <option value="">— Any —</option>
                                            @foreach (var opt in (benchmarkFilters?.DegreeLevels ?? new()))
                                            {
                                                <option value="@opt">@opt</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="bm-filter-field">
                                        <label class="bm-filter-label">Field of Education (FOE)</label>
                                        <select class="dropDownList1"
                                                @bind="program.BmFoe"
                                                @bind:after="OnBenchmarkFilterChanged">
                                            <option value="">— Any —</option>
                                            @foreach (var opt in (benchmarkFilters?.FoeCodes ?? new()))
                                            {
                                                <option value="@opt">@opt</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="bm-filter-field">
                                        <label class="bm-filter-label">Period</label>
                                        <select class="dropDownList1"
                                                @bind="program.BmPeriodName"
                                                @bind:after="OnBenchmarkFilterChanged">
                                            <option value="">— Any —</option>
                                            @foreach (var opt in (benchmarkFilters?.PeriodNames ?? new()))
                                            {
                                                <option value="@opt">@opt</option>
                                            }
                                        </select>
                                    </div>
                                </div>
                            }
                        </div>

                        @if (calculationResult is null)
                        {
                            <div class="intel-prereq">
                                <i class="fa-solid fa-circle-info"></i>
                                <div>
                                    <strong>Run the calculation first.</strong> Go to the Results tab and run the calculation, then come back here to see how this program compares against sector benchmarks.
                                </div>
                            </div>
                        }
                        else if (isLoadingBenchmark)
                        {
                            <div class="calc-loading">
                                <div class="calc-loading-spinner"></div>
                                <div class="calc-loading-title">Loading benchmark data…</div>
                                <p class="calc-loading-desc">Querying sector data for your peer group.</p>
                            </div>
                        }
                        else if (!string.IsNullOrWhiteSpace(benchmarkError))
                        {
                            <div class="mapping-error">@benchmarkError</div>
                            <div style="margin-top:12px;">
                                <button type="button" class="button2" @onclick="LoadBenchmarkDataAsync">
                                    <i class="fa-solid fa-rotate-right"></i> Retry
                                </button>
                            </div>
                        }
                        else if (benchmarkData.Count == 0)
                        {
                            <div class="bm-empty-state">
                                <i class="fa-solid fa-chart-bar"></i>
                                <p>No benchmark data returned for the selected filters. Try adjusting the <strong>Degree Level</strong>, <strong>FOE</strong>, or <strong>Period</strong> above.</p>
                            </div>
                        }
                        else
                        {
                            <div class="bm-layout">

                                @* Context strip *@
                                @{
                                    var summaryN = benchmarkData.Max(m => m.BenchmarkN);
                                    var summaryConf = benchmarkData.FirstOrDefault(m => !string.IsNullOrWhiteSpace(m.Confidence))?.Confidence ?? "";
                                }
                                <div class="bm-summary-strip">
                                    @if (!string.IsNullOrWhiteSpace(program.BmDegreeLevel))
                                    {
                                        <span class="bm-summary-item"><i class="fa-solid fa-graduation-cap"></i> @program.BmDegreeLevel</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(program.BmFoe))
                                    {
                                        <span class="bm-summary-item"><i class="fa-solid fa-tag"></i> FOE @program.BmFoe</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(program.BmPeriodName))
                                    {
                                        <span class="bm-summary-item"><i class="fa-solid fa-calendar"></i> @program.BmPeriodName</span>
                                    }
                                    <span class="bm-summary-item"><i class="fa-solid fa-database"></i> <strong>@summaryN</strong> institutions</span>
                                    @if (!string.IsNullOrWhiteSpace(summaryConf))
                                    {
                                        <span class="bm-summary-item @($"bm-conf-{summaryConf.ToLower().Replace(" ", "-")}")">
                                            <i class="fa-solid fa-shield-halved"></i> <strong>@summaryConf</strong> confidence
                                        </span>
                                    }
                                    <button type="button" class="button2" style="margin-left:auto;padding:4px 10px;font-size:12px;" @onclick="LoadBenchmarkDataAsync" disabled="@isLoadingBenchmark">
                                        <i class="fa-solid fa-rotate-right"></i> Refresh
                                    </button>
                                </div>

                                @* Program Fit *@
                                @{
                                    var fitRows = BenchmarkFitRows().ToList();
                                }
                                @if (fitRows.Any())
                                {
                                    <div class="bm-section">
                                        <p class="cr-panel-title">Program Fit</p>
                                        <p style="font-size:12px;color:#64748b;margin:0 0 12px;">
                                            Compares this program's cost, revenue and margin against the sector weighted mean. Revenue and margin are averaged per EFTSL across all forecast years. The bar spans the benchmark min–max range; the grey tick is the sector mean and the blue marker is this program.
                                        </p>
                                        <table class="tableStyle2 bm-fit-table">
                                            <thead>
                                                <tr>
                                                    <th>Metric</th>
                                                    <th>This Program</th>
                                                    <th class="bm-col-min">Min</th>
                                                    <th class="bm-col-range">Range</th>
                                                    <th class="bm-col-mean">Wtd Mean</th>
                                                    <th class="bm-col-max">Max</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var row in fitRows)
                                                {
                                                    // CPH: derive min/max/mean from Staff Salary ÷ Delivery Hours
                                                    double? bmMin = null, bmMax = null, bmMid = null;
                                                    if (row.Label == "Faculty Cost / Hour")
                                                    {
                                                        var staffM = benchmarkData.FirstOrDefault(m => m.Measure == BenchmarkService.MeasureStaffSalaryPerEftsl);
                                                        var hoursM = benchmarkData.FirstOrDefault(m => m.Measure == BenchmarkService.MeasureDeliveryHoursPerEftsl);
                                                        if (staffM is not null && hoursM is not null)
                                                        {
                                                            var hMean = hoursM.WeightedMean ?? 0;
                                                            var hMin  = hoursM.Min ?? 0;
                                                            var hMax  = hoursM.Max ?? 0;
                                                            if (hMean > 0) bmMid = (staffM.WeightedMean ?? 0) / hMean;
                                                            if (hMin  > 0) bmMin = (staffM.Min ?? 0) / hMin;
                                                            if (hMax  > 0) bmMax = (staffM.Max ?? 0) / hMax;
                                                        }
                                                    }
                                                    else
                                                    {
                                                        var bm = benchmarkData.FirstOrDefault(m => m.Measure == row.BmMeasure);
                                                        if (bm is not null)
                                                        {
                                                            bmMin = bm.Min;
                                                            bmMax = bm.Max;
                                                            bmMid = bm.WeightedMean;
                                                        }
                                                    }
                                                    var pct = BmPositionPct(row.ProgramValue, bmMin, bmMax);
                                                    var isAbove = bmMax.HasValue && row.ProgramValue > bmMax.Value;
                                                    var isBelow = bmMin.HasValue && row.ProgramValue < bmMin.Value;
                                                    <tr>
                                                        <td>@row.Label</td>
                                                        <td class="@(isAbove ? "bm-above" : isBelow ? "bm-below" : "bm-within")">
                                                            @row.ProgramValue.ToString(row.Format)
                                                            @if (isAbove) { <i class="fa-solid fa-arrow-up" style="font-size:10px;margin-left:3px;" title="Above sector max"></i> }
                                                            else if (isBelow) { <i class="fa-solid fa-arrow-down" style="font-size:10px;margin-left:3px;" title="Below sector min"></i> }
                                                            else { <i class="fa-solid fa-check" style="font-size:10px;margin-left:3px;" title="Within sector range"></i> }
                                                        </td>
                                                        <td class="bm-col-min">@(bmMin?.ToString(row.Format) ?? "–")</td>
                                                        <td class="bm-col-range">
                                                            @if (bmMin is not null && bmMax is not null)
                                                            {
                                                                <div class="bm-range-bar">
                                                                    <div class="bm-range-fill"></div>
                                                                    @if (bmMid.HasValue)
                                                                    {
                                                                        var midPct = BmPositionPct(bmMid.Value, bmMin, bmMax);
                                                                        <div class="bm-range-avg" style="left:@(midPct.ToString("F1"))%"></div>
                                                                    }
                                                                    <div class="bm-range-marker" style="left:@(pct.ToString("F1"))%"></div>
                                                                </div>
                                                            }
                                                        </td>
                                                        <td class="bm-col-mean">@(bmMid?.ToString(row.Format) ?? "–")</td>
                                                        <td class="bm-col-max">@(bmMax?.ToString(row.Format) ?? "–")</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }

                                @* Full benchmark measures table *@
                                <div class="bm-section">
                                    <p class="cr-panel-title">All Benchmark Measures</p>
                                    <table class="tableStyle2 bm-full-table">
                                        <thead>
                                            <tr>
                                                <th>Measure</th>
                                                <th>Min</th>
                                                <th>Wtd Mean</th>
                                                <th>Median</th>
                                                <th>Max</th>
                                                <th>N</th>
                                                <th>Confidence</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var m in benchmarkData.OrderBy(m => m.Measure))
                                            {
                                                <tr>
                                                    <td>@m.Measure</td>
                                                    <td>@(m.Min?.ToString("N2") ?? "–")</td>
                                                    <td>@(m.WeightedMean?.ToString("N2") ?? "–")</td>
                                                    <td>@(m.Median?.ToString("N2") ?? "–")</td>
                                                    <td>@(m.Max?.ToString("N2") ?? "–")</td>
                                                    <td>@m.BenchmarkN</td>
                                                    <td>@m.Confidence</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>

                            </div>
                        }

                        <div class="tab-footer-actions" style="margin-top:20px;">
                            <button type="button" class="button2" @onclick="MoveToNextTab">
                                Next: Intelligence <i class="fa-solid fa-chevron-right"></i>
                            </button>
                        </div>
                    </div>
                </div>
            }

            @if (activeTab == "Intelligence")
            {
                <div class="tabcontent" style="display:block;">
                    <div class="fixedTableWidth">
                        <div class="tab-section-header">
                            <h3 class="tab-section-title">Pilbara Intelligence</h3>
                            <p class="tab-section-desc">Generate an AI-powered financial business case from your calculation results using Snowflake Cortex.</p>
                        </div>

                        @if (calculationResult is null)
                        {
                            <div class="intel-prereq">
                                <i class="fa-solid fa-circle-info"></i>
                                <div>
                                    <strong>Run a calculation first.</strong> Pilbara Intelligence analyses your year-by-year results to produce a financial business case. Go to the Results tab and run the calculation, then come back here.
                                </div>
                            </div>
                        }
                        else if (!cortexAvailable)
                        {
                            <div class="intel-prereq">
                                <i class="fa-solid fa-triangle-exclamation"></i>
                                <div>
                                    Your Snowflake role does not have Cortex access. Ask support to grant
                                    <code>SNOWFLAKE.CORTEX_USER</code> to your role.
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="intel-panel">
                                <div class="intel-toolbar">
                                    <select class="dropDownList1 intel-model-select" @bind="cortexModel" disabled="@isGenerating">
                                        <option value="mistral-large2">mistral-large2</option>
                                        <option value="llama3.1-70b">llama3.1-70b</option>
                                        <option value="llama3.1-405b">llama3.1-405b</option>
                                        <option value="snowflake-arctic">snowflake-arctic</option>
                                    </select>
                                    <button type="button" class="button1" @onclick="GenerateBusinessCase" disabled="@isGenerating">
                                        <i class="fa-solid fa-wand-magic-sparkles"></i>
                                        @(string.IsNullOrEmpty(cortexResponse) ? "Generate Business Case" : "Regenerate")
                                    </button>
                                    @if (calculationIsStale)
                                    {
                                        <span class="wizard-hint" style="color:#f59e0b;">
                                            <i class="fa-solid fa-triangle-exclamation"></i> Results may be stale — recalculate first for accurate output.
                                        </span>
                                    }
                                </div>

                                @if (!string.IsNullOrWhiteSpace(cortexError))
                                {
                                    <div class="mapping-error">@cortexError</div>
                                }

                                @if (isGenerating)
                                {
                                    <div class="intel-spinner-wrap">
                                        <div class="intel-spinner"></div>
                                        <span>Sending to Cortex — this may take 20–60 seconds…</span>
                                    </div>
                                }
                                else if (!string.IsNullOrWhiteSpace(cortexResponse))
                                {
                                    <div class="intel-response-box">
                                        @CortexService.RenderMarkdown(cortexResponse)
                                    </div>
                                }
                                else
                                {
                                    <div class="intel-empty-state">
                                        <i class="fa-solid fa-brain"></i>
                                        Select a model and click <strong>Generate Business Case</strong> to produce an AI-authored financial analysis.
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>

    @if (isUnitPickerOpen)
    {
        <div class="unit-picker-overlay" @onclick="UnitPickerOverlayClick">
            <div class="unit-picker-modal" @onclick:stopPropagation="true">

                <div class="unit-picker-header">
