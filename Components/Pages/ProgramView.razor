                    <button type="button" class="row-action-btn" @onclick="CloseUnitPicker" title="Close">
                        <i class="fa-solid fa-xmark"></i>
                    </button>
                </div>

                <div class="unit-picker-body">

                    @* LEFT: unit search + selection *@
                    <div class="unit-picker-left">
                        <div class="unit-picker-filters">
                            <input type="text" class="search-input unit-picker-search-input" placeholder="Search by unit code or name..."
                                   @bind="unitSearch" @bind:event="oninput" />
                            <select class="dropDownList1 unit-picker-school-filter" @bind="unitSchoolFilter">
                                <option value="">All Schools</option>
