                    </div>

                    @* RIGHT: profile + FOE (scrollable) *@
                    <div class="unit-picker-right">
                        <div class="unit-picker-section">
                            <label class="meta-label" style="display:block;margin-bottom:6px;">Profile</label>
                            <select class="dropDownList1" style="width:100%;" @bind="selectedPickerProfile">
                                @foreach (var profile in program.Profiles)
                                {
                                    <option value="@profile.Name">@profile.Name</option>
                                }
                                <option value="Custom">Custom Profile</option>
                            </select>
                            @if (selectedPickerProfile == "Custom")
                            {
                                <div class="profile-preview">
                                    <div class="custom-profile-grid">
                                        <div class="custom-profile-field">
                                            <span class="profile-preview-label">Tut Size</span>
                                            <input type="number" step="any" class="textBoxStyle4"
                                                   @bind="customTutSize" @bind:event="oninput" />
                                        </div>
                                        <div class="custom-profile-field">
                                            <span class="profile-preview-label">Lect Hours</span>
                                            <input type="number" step="any" class="textBoxStyle4"
                                                   @bind="customLectHours" @bind:event="oninput" />
                                        </div>
                                        <div class="custom-profile-field">
                                            <span class="profile-preview-label">Tut Hours</span>
                                            <input type="number" step="any" class="textBoxStyle4"
                                                   @bind="customTutHours" @bind:event="oninput" />
                                        </div>
                                        <div class="custom-profile-field">
                                            <span class="profile-preview-label">Prep Hours</span>
                                            <input type="number" step="any" class="textBoxStyle4"
                                                   @bind="customPrepHours" @bind:event="oninput" />
                                        </div>
                                        <div class="custom-profile-field">
                                            <span class="profile-preview-label">Admin Hours</span>
                                            <input type="number" step="any" class="textBoxStyle4"
                                                   @bind="customAdminHours" @bind:event="oninput" />
                                        </div>
                                        <div class="custom-profile-field">
                                            <span class="profile-preview-label">Student Hours</span>
                                            <input type="number" step="any" class="textBoxStyle4"
                                                   @bind="customStudentHours" @bind:event="oninput" />
                                        </div>
                                    </div>
                                </div>
                            }
                            else if (SelectedPickerProfile is not null)
                            {
                                <div class="profile-preview">
                                    <div class="profile-preview-grid">
                                        <div class="profile-preview-item"><span class="profile-preview-label">Tut Size</span><span class="profile-preview-value">@FormatNumber(SelectedPickerProfile.TutSize)</span></div>
                                        <div class="profile-preview-item"><span class="profile-preview-label">Lect Hours</span><span class="profile-preview-value">@FormatNumber(SelectedPickerProfile.LectureHours)</span></div>
                                        <div class="profile-preview-item"><span class="profile-preview-label">Tut Hours</span><span class="profile-preview-value">@FormatNumber(SelectedPickerProfile.TutorialHours)</span></div>
                                        <div class="profile-preview-item"><span class="profile-preview-label">Prep Hours</span><span class="profile-preview-value">@FormatNumber(SelectedPickerProfile.PreparationHours)</span></div>
                                        <div class="profile-preview-item"><span class="profile-preview-label">Admin Hours</span><span class="profile-preview-value">@FormatNumber(SelectedPickerProfile.AdministrationHours)</span></div>
                                        <div class="profile-preview-item"><span class="profile-preview-label">Student Hours</span><span class="profile-preview-value">@FormatNumber(SelectedPickerProfile.StudentHours)</span></div>
                                    </div>
                                </div>
                            }
                        </div>

                        @if (selectedPickerUnit != "New Unit" && !string.IsNullOrWhiteSpace(selectedPickerUnit))
                        {
                            var uv = program.UnitValues.FirstOrDefault(v => v.UnitName == selectedPickerUnit);
                            <div class="unit-picker-section">
                                <label class="meta-label" style="display:block;margin-bottom:6px;">Model Values</label>
                                @if (uv is not null)
                                {
                                    <div class="profile-preview">
                                        <div class="profile-preview-grid">
                                            <div class="profile-preview-item">
                                                <span class="profile-preview-label">Exp / Hour</span>
                                                <span class="profile-preview-value">@FormatCurrency(uv.FacultyCostPerHour)</span>
                                            </div>
                                            <div class="profile-preview-item">
                                                <span class="profile-preview-label">CGS Rev / EFTSL</span>
                                                <span class="profile-preview-value">@FormatCurrency(uv.CgsRevenuePerEftsl)</span>
                                            </div>
                                            <div class="profile-preview-item">
                                                <span class="profile-preview-label">Dom Rev / EFTSL</span>
                                                <span class="profile-preview-value">@FormatCurrency(uv.DomesticRevenuePerEftsl)</span>
                                            </div>
                                            <div class="profile-preview-item">
                                                <span class="profile-preview-label">Int Rev / EFTSL</span>
                                                <span class="profile-preview-value">@FormatCurrency(uv.InternationalRevenuePerEftsl)</span>
                                            </div>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="foe-selected-hint" style="color:#94a3b8;">
                                        <i class="fa-solid fa-circle-info"></i>
                                        <span>No model values available for this unit.</span>
                                    </div>
                                }
                            </div>
                        }

                        @if (program.FoeCodeOptions.Count > 0)
                        {
                            <div class="unit-picker-section unit-picker-section-foe">
                                <label class="meta-label" style="display:block;margin-bottom:6px;">
                                    FOE Code
                                    <span class="wizard-hint" style="font-size:0.8em;margin-left:4px;">(CGS Funding Cluster rate)</span>
                                </label>
                                @if (selectedPickerUnit == "New Unit")
                                {
                                    <div class="foe-picker-filters">
                                        <input type="text" class="search-input foe-picker-search"
                                               placeholder="Search code or title..."
                                               @bind="foeSearch" @bind:event="oninput" />
                                        <select class="dropDownList1 foe-picker-filter"
                                                value="@foeBroadFilter"
                                                @onchange="OnFoeBroadChanged">
                                            <option value="">All Broad FOE</option>
                                            @foreach (var opt in FoeBroadOptions)
                                            {
                                                <option value="@opt.Code">@opt.Code</option>
                                            }
                                        </select>
                                        <select class="dropDownList1 foe-picker-filter" @bind="foeNarrowFilter">
                                            <option value="">All Narrow FOE</option>
                                            @foreach (var opt in FoeNarrowOptions)
                                            {
                                                <option value="@opt.Code">@opt.Code</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="foe-picker-list">
                                        @if (!FilteredFoeOptions.Any())
                                        {
                                            <div class="foe-picker-empty">No FOE codes match your search.</div>
                                        }
                                        else
                                        {
                                            @foreach (var foe in FilteredFoeOptions)
                                            {
                                                <div class="foe-picker-item @(selectedPickerFoe == foe.FoeCodeDetailed ? "selected" : "")"
                                                     @onclick="() => selectedPickerFoe = foe.FoeCodeDetailed">
                                                    <span class="foe-code">@foe.FoeCodeDetailed</span>
                                                    <span class="foe-cluster-badge">@foe.FundingCluster</span>
                                                </div>
                                            }
                                        }
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(selectedPickerFoe))
                                    {
                                        var sel = program.FoeCodeOptions.FirstOrDefault(f => f.FoeCodeDetailed == selectedPickerFoe);
                                        if (sel is not null)
                                        {
                                            <div class="foe-selected-hint">
                                                <i class="fa-solid fa-circle-check" style="color:#22c55e;"></i>
                                                <span><strong>@sel.FoeCodeDetailed</strong> &nbsp;|&nbsp; @sel.FundingCluster &nbsp;|&nbsp; @sel.CgsRatePerEftsl.ToString("C0") / EFTSL</span>
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <div class="foe-selected-hint" style="color:#94a3b8;">
                                            <i class="fa-solid fa-circle-info"></i>
                                            <span>No FOE selected — CGS rate defaults to 0 for this unit.</span>
                                        </div>
                                    }
                                }
                                else
                                {
                                    @if (!string.IsNullOrWhiteSpace(selectedPickerFoe))
                                    {
                                        var sel = program.FoeCodeOptions.FirstOrDefault(f => f.FoeCodeDetailed == selectedPickerFoe);
                                        if (sel is not null)
                                        {
                                            <div class="foe-selected-hint">
                                                <i class="fa-solid fa-circle-check" style="color:#22c55e;"></i>
                                                <span><strong>@sel.FoeCodeDetailed</strong> &nbsp;|&nbsp; @sel.FundingCluster &nbsp;|&nbsp; @sel.CgsRatePerEftsl.ToString("C0") / EFTSL</span>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="foe-selected-hint" style="color:#94a3b8;">
                                                <i class="fa-solid fa-circle-info"></i>
                                                <span>FOE: @selectedPickerFoe — rate not found in current year options.</span>
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <div class="foe-selected-hint" style="color:#94a3b8;">
                                            <i class="fa-solid fa-circle-info"></i>
                                            <span>No FOE assigned — CGS rate defaults to 0 for this unit.</span>
                                        </div>
                                    }
                                }
                            </div>
                        }
                    </div>

                </div>

                <div class="unit-picker-footer">
                    <button type="button" class="button2" @onclick="CloseUnitPicker">Cancel</button>
                    <button type="button" class="button1" @onclick="ConfirmUnitPicker">@(editingUnit is null ? "Add Unit" : "Update Unit")</button>
                </div>
            </div>
        </div>
    }
}

@code {
    [Parameter] public Guid ProgramId { get; set; }
    [Inject] private ProgramService ProgramSvc { get; set; } = default!;
    [Inject] private ProgramCalculationService CalculationSvc { get; set; } = default!;
    [Inject] private ExcelExportService ExportSvc { get; set; } = default!;
    [Inject] private CortexService CortexSvc { get; set; } = default!;
    [Inject] private BenchmarkService BenchmarkSvc { get; set; } = default!;
    [Inject] private ITenantContext TenantCtx { get; set; } = default!;

    private static readonly string[] allTabs = ["Details", "InputData", "Units", "CostRevenue", "Results", "BreakEven", "Compare", "Benchmark", "Intelligence"];
    // The Preview has no Cortex access, so it never shows the Intelligence tab.
    private static readonly string[] previewTabs = allTabs.Where(t => t != "Intelligence").ToArray();
    private bool isPreview;
    private string[] tabs => isPreview ? previewTabs : allTabs;
    [Inject] private NavigationManager Nav { get; set; } = default!;
    private ProgramDetailsDto? program;
    private string activeTab = "Details";
    private bool isLoading = true;
    private string? loadError;
    private string? saveError;
    private string? statusMessage;
    private string? calcError;
    private int degreeYearCount = 1;
    private bool isCalculating;
    private bool calculationIsStale;
    private ProgramCalculationResultDto? calculationResult;
    private byte[]? exportBytes;
    private HashSet<int> expandedYears = new();
    private bool pendingChartRender;

    private string cortexModel = "mistral-large2";
    private string cortexResponse = "";
    private bool isGenerating;
    private string? cortexError;

    // ── Tags ─────────────────────────────────────────────────────
    private string newTagInput = "";
    private List<string> ParsedTags => program?.Tags
        .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
        .ToList() ?? new();

    private void AddTag()
    {
        if (string.IsNullOrWhiteSpace(newTagInput) || program is null) return;
        var trimmed = newTagInput.Trim();
        var tags = ParsedTags;
        if (!tags.Contains(trimmed, StringComparer.OrdinalIgnoreCase))
            tags.Add(trimmed);
        program.Tags = string.Join(", ", tags);
        newTagInput = "";
    }

    private void RemoveTag(string tag)
    {
        if (program is null) return;
        program.Tags = string.Join(", ", ParsedTags.Where(t => !t.Equals(tag, StringComparison.OrdinalIgnoreCase)));
    }

    private void OnTagInputKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") AddTag();
    }

    // ── Setup checklist helpers ──────────────────────────────────
    private int SetupStepsComplete =>
        (InputDataReady ? 1 : 0) + (UnitsReady ? 1 : 0) +
        (CostRevenueReady ? 1 : 0) + (calculationResult is not null ? 1 : 0);

    private (string Title, string Description, string ButtonText, string TabTarget) GetSuggestedNextStep()
    {
        if (!InputDataReady)
            return ("Add input data", "Enter EFTSL enrolment values for each projection year to get started.", "Go to Input Data", "InputData");
        if (!UnitsReady)
            return ("Add program units", "Add the units that make up this program and assign delivery profiles.", "Go to Units", "Units");
        if (!CostRevenueReady)
            return ("Set cost & revenue", "Configure faculty cost per hour and non-faculty cost per EFTSL.", "Go to Cost & Revenue", "CostRevenue");
        if (calculationResult is null || calculationIsStale)
            return ("Run calculation", "All setup steps are done. Run your first calculation to see projected results and breakeven analysis.", "Run calculation", "Results");
        return ("Review your results", "Your calculation is up to date. Explore the Results, Breakeven, and Benchmark tabs.", "View Results", "Results");
    }

    // ── Benchmark state ───────────────────────────────────────────
    private BenchmarkFilterOptionsDto? benchmarkFilters;
    private List<BenchmarkMeasureDto> benchmarkData = new();
    private bool benchmarkFiltersLoaded;
    private bool isLoadingBenchmarkFilters;
    private bool isLoadingBenchmark;
    private string? benchmarkError;
    private string? cgsYearError;

    // Whether the signed-in user's Snowflake role can reach Cortex. Resolved once at
    // load rather than probed per render.
    private bool cortexAvailable;

    private int selectedBreakevenYearIndex;
    private bool isUnitPickerOpen;
    private bool unitPickerError;
    private int unitPickerYear = 1;
    private ProgramUnitDto? editingUnit;
    private string selectedPickerUnit = "";
    private string selectedPickerProfile = "";
    private string selectedPickerFoe = "";
    private string foeSearch = "";
    private string foeBroadFilter = "";
    private string foeNarrowFilter = "";
    private string newUnitCustomName = "";
    private double customTutSize;
    private double customLectHours;
    private double customTutHours;
    private double customPrepHours;
    private double customAdminHours;
    private double customStudentHours;
    private string unitSearch = "";
    private string unitSchoolFilter = "";

    private int DegreeYearCount => Math.Max(degreeYearCount, Math.Max(1, program?.Units.Select(u => u.ProgramYear).DefaultIfEmpty(1).Max() ?? 1));

    private IEnumerable<string> Schools =>
        program?.ModelValues.Select(v => v.School).Where(s => !string.IsNullOrWhiteSpace(s)).Distinct().OrderBy(s => s)
        ?? Enumerable.Empty<string>();

    private IEnumerable<string> Courses =>
        program?.ModelValues
            .Where(v => string.IsNullOrWhiteSpace(program.SchoolSelect) || v.School == program.SchoolSelect)
            .Select(v => v.CourseName)
            .Where(c => !string.IsNullOrWhiteSpace(c))
            .Distinct()
            .OrderBy(c => c)
        ?? Enumerable.Empty<string>();

    private IEnumerable<ProgramUnitOptionDto> FilteredUnitOptions =>
        program?.UnitOptions
            .Where(u => string.IsNullOrWhiteSpace(program.SchoolSelect) || u.School == program.SchoolSelect)
            .OrderBy(u => u.Name)
        ?? Enumerable.Empty<ProgramUnitOptionDto>();

    private IEnumerable<ProgramUnitOptionDto> UnitPickerOptions =>
        program?.UnitOptions
            .Where(u => string.IsNullOrWhiteSpace(unitSchoolFilter) || u.School == unitSchoolFilter)
            .Where(u => string.IsNullOrWhiteSpace(unitSearch) || u.Name.Contains(unitSearch, StringComparison.OrdinalIgnoreCase))
            .OrderBy(u => u.Name)
        ?? Enumerable.Empty<ProgramUnitOptionDto>();

    private IEnumerable<FoeCodeOptionDto> FilteredFoeOptions =>
        program?.FoeCodeOptions
            .Where(f => string.IsNullOrWhiteSpace(foeBroadFilter) || f.FoeCodeBroad == foeBroadFilter)
            .Where(f => string.IsNullOrWhiteSpace(foeNarrowFilter) || f.FoeCodeNarrow == foeNarrowFilter)
            .Where(f => string.IsNullOrWhiteSpace(foeSearch) ||
                f.FoeCodeDetailed.Contains(foeSearch, StringComparison.OrdinalIgnoreCase) ||
                f.FoeTitleDetailed.Contains(foeSearch, StringComparison.OrdinalIgnoreCase))
        ?? Enumerable.Empty<FoeCodeOptionDto>();

    private IEnumerable<(string Code, string Title)> FoeBroadOptions =>
        program?.FoeCodeOptions
            .Select(f => (Code: f.FoeCodeBroad, Title: f.FoeTitleBroad))
            .Distinct()
            .OrderBy(f => f.Code)
        ?? Enumerable.Empty<(string, string)>();

    private IEnumerable<(string Code, string Title)> FoeNarrowOptions =>
        program?.FoeCodeOptions
            .Where(f => string.IsNullOrWhiteSpace(foeBroadFilter) || f.FoeCodeBroad == foeBroadFilter)
            .Select(f => (Code: f.FoeCodeNarrow, Title: f.FoeTitleNarrow))
            .Distinct()
            .OrderBy(f => f.Code)
        ?? Enumerable.Empty<(string, string)>();

    private ProgramProfileDto? SelectedPickerProfile =>
        selectedPickerProfile == "Custom"
            ? new ProgramProfileDto
            {
                Name = "Custom",
                TutSize = customTutSize,
                LectureHours = customLectHours,
                TutorialHours = customTutHours,
                PreparationHours = customPrepHours,
                AdministrationHours = customAdminHours,
                StudentHours = customStudentHours
            }
            : program?.Profiles.FirstOrDefault(p => p.Name == selectedPickerProfile);

    private List<ModelValueSummaryDto> ModelValueSummaries =>
        program?.ModelValues
            .Where(v => string.IsNullOrWhiteSpace(program.SchoolSelect) || v.School == program.SchoolSelect)
            .Where(v => string.IsNullOrWhiteSpace(program.CourseSelect) || v.CourseName == program.CourseSelect)
            .GroupBy(v => new { v.School, v.Career })
            .Select(g =>
            {
                var facultyExpense = g.Sum(x => x.FacultyExpense);
                var nonFacultyExpense = g.Sum(x => x.NonFacultyExpense);
                var domEftsl = g.Sum(x => x.DomesticEftsl);
                var intEftsl = g.Sum(x => x.InternationalEftsl);
                var cgsEftsl = g.Sum(x => x.CgsEftsl);
                var totalEftsl = domEftsl + intEftsl + cgsEftsl;
                var deliveryHours = g.Sum(x => x.DeliveryHours);
                return new ModelValueSummaryDto
                {
                    School = g.Key.School,
                    Career = g.Key.Career,
                    CostPerHour = deliveryHours == 0 ? 0 : facultyExpense / deliveryHours,
                    NonCostPerEftsl = totalEftsl == 0 ? 0 : nonFacultyExpense / totalEftsl,
                    RevCgsPerEftsl = cgsEftsl == 0 ? 0 : g.Sum(x => x.CgsRevenue) / cgsEftsl,
                    RevDomPerEftsl = domEftsl == 0 ? 0 : g.Sum(x => x.DomesticRevenue) / domEftsl,
                    RevIntPerEftsl = intEftsl == 0 ? 0 : g.Sum(x => x.InternationalRevenue) / intEftsl,
                    DeliveryHours = deliveryHours,
                    DomesticEftsl = domEftsl,
                    InternationalEftsl = intEftsl
                };
            })
            .OrderBy(v => v.Career)
            .ToList()
        ?? new List<ModelValueSummaryDto>();

    private ModelValueSummaryDto? SelectedModelValue =>
        ModelValueSummaries.FirstOrDefault(v => v.Career == program?.CareerSelect);

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;
        loadError = null;
        try
        {
            var access = await TenantCtx.GetAsync();
            if (access.NeedsChoice)
            {
                Nav.NavigateTo("/choose-institution");
                return;
            }
            if (!access.Ok)
            {
                loadError = access.Reason;
                return;
            }
            cortexAvailable = access.Capabilities.Cortex;
            isPreview = access.Tier == AccessTier.Preview;

            program = await ProgramSvc.GetDetailsAsync(ProgramId);
            if (program is null)
            {
                loadError = "Program not found.";
                return;
            }

            degreeYearCount = Math.Max(1, program.Units.Select(u => u.ProgramYear).DefaultIfEmpty(1).Max());
            if (program.Settings.Count == 0)
            {
                program.Settings.Add(new ProgramYearSettingDto { Year = 0 });
            }
            if (string.IsNullOrWhiteSpace(program.Profile) && program.Profiles.Count > 0)
            {
                program.Profile = program.Profiles[0].Name;
            }

            // Load benchmark filter options in the background (populates Details tab dropdowns)
            if (!benchmarkFiltersLoaded)
                _ = LoadBenchmarkFiltersAsync();

            // Load the benchmark measures too, so a Benchmark cost source resolves
            // straight away rather than only after the Benchmark tab has been opened.
            if (HasBenchmarkFilters)
                _ = EnsureBenchmarkDataAsync();
        }
        catch (Exception ex)
        {
            loadError = $"Failed to load program: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

