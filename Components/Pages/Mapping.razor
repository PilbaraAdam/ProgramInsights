@page "/scenario/{ScenarioId:guid}/mapping"
@rendermode InteractiveServer
@using ProgramInsights.Services.Tenancy

<PageTitle>Data Connection — Program Insights</PageTitle>

<div class="content-container">
    <ul class="breadcrumb">
        <li><a href="/">Home</a></li>
        <li>Data Connection</li>
    </ul>

    <div class="wizard-header">
        <h1 class="wizard-title">Data Connection</h1>
        <p class="wizard-subtitle">Connect this scenario to a Snowflake source database containing <strong>VW_APP_COURSE_UNIT_SUMMARY</strong>.</p>
    </div>

    <!-- Step indicator -->
    <div class="wizard-steps">
        @for (var i = 1; i <= StepLabels.Length; i++)
        {
            var idx = i;
            var cls = idx < step ? "step-done" : idx == step ? "step-active" : "step-pending";
            <div class="wizard-step @cls">
                <div class="wizard-step-circle">
                    @if (idx < step) { <i class="fa-solid fa-check"></i> }
                    else { <span>@idx</span> }
                </div>
                <div class="wizard-step-label">@StepLabels[idx - 1]</div>
            </div>
            @if (idx < StepLabels.Length)
            {
                <div class="wizard-step-line @(idx < step ? "line-done" : "line-pending")"></div>
            }
        }
    </div>

    <!-- Content card -->
    <div class="wizard-card">

        @if (!string.IsNullOrEmpty(workError))
        {
            <div class="mapping-error" style="margin-bottom:16px;">@workError</div>
        }

        <!-- Step 1: Connect -->
        @if (step == 1)
        {
            <h2 class="wizard-step-title">Step 1 — Connect</h2>
            <p class="wizard-step-desc">
                Enter the Snowflake database and schema that contains <strong>VW_APP_COURSE_UNIT_SUMMARY</strong>,
                then click Verify to confirm the view is accessible.
            </p>

            <div class="wizard-field">
                <label class="wizard-label">Source Database</label>
                <input type="text" class="textBoxStyle4" @bind="config.SourceDatabase"
                       placeholder="e.g. USC_CSA_PRI" style="max-width:360px;" />
            </div>
            <div class="wizard-field">
                <label class="wizard-label">Schema</label>
                <div style="display:flex;gap:8px;align-items:flex-start;flex-wrap:wrap;">
                    <input type="text" class="textBoxStyle4" @bind="config.SourceSchema"
                           placeholder="PUBLIC" style="max-width:200px;" />
                    <button type="button" class="button2" @onclick="VerifyViewAsync"
                            disabled="@(isWorking || string.IsNullOrWhiteSpace(config.SourceDatabase))">
                        @if (isWorking)
                        {
                            <i class="fa-solid fa-spinner fa-spin"></i>
                        }
                        else
                        {
                            <i class="fa-solid fa-plug"></i>
                        }
                        Verify
                    </button>
                </div>
                <span class="wizard-hint">Usually PUBLIC — the schema where VW_APP_COURSE_UNIT_SUMMARY was created.</span>
            </div>

            @if (viewVerified)
            {
                <div class="mapping-success" style="margin-top:12px;">
                    <i class="fa-solid fa-circle-check"></i>
                    VW_APP_COURSE_UNIT_SUMMARY found in @config.SourceDatabase.@config.SourceSchema
                </div>
            }
        }

        <!-- Step 2: Filter -->
        @if (step == 2)
        {
            <h2 class="wizard-step-title">Step 2 — Filter</h2>
            <p class="wizard-step-desc">Select which model and reporting period to use from the source view.</p>

            <div class="wizard-field">
                <label class="wizard-label">Model</label>
                <select class="dropDownList1" style="max-width:360px;" @bind="config.ModelFilter">
                    @foreach (var m in availableModels)
                    {
                        <option value="@m">@m</option>
                    }
                </select>
                <span class="wizard-hint">@availableModels.Count distinct model value@(availableModels.Count == 1 ? "" : "s") found.</span>
            </div>
            <div class="wizard-field">
                <label class="wizard-label">Period</label>
                <select class="dropDownList1" style="max-width:360px;" @bind="config.PeriodFilter">
                    @foreach (var p in availablePeriods)
                    {
                        <option value="@p">@p</option>
                    }
                </select>
                <span class="wizard-hint">@availablePeriods.Count period@(availablePeriods.Count == 1 ? "" : "s") found, most recent first.</span>
            </div>
        }

        <!-- Step 3: Register -->
        @if (step == 3)
        {
            <h2 class="wizard-step-title">Step 3 — Register</h2>
            <p class="wizard-step-desc">Review your connection settings and click Register to save.</p>

            <div class="wizard-field">
                <div class="sql-preview-block">
                    <div class="sql-preview-label">Connection Summary</div>
                    <div style="padding:14px 16px;font-size:13px;line-height:1.8;background:#f8fafc;border-radius:0 0 8px 8px;">
                        <strong>View:</strong> @($"{config.SourceDatabase}.{config.SourceSchema}.VW_APP_COURSE_UNIT_SUMMARY")<br />
                        <strong>Model:</strong> @config.ModelFilter<br />
                        <strong>Period:</strong> @config.PeriodFilter
                    </div>
                </div>
            </div>

            @if (registered)
            {
                <div class="mapping-success">
                    <i class="fa-solid fa-circle-check"></i>
                    Connection registered. Unit and course values will be read live from your Snowflake source.
                </div>
            }
        }

        <!-- Wizard navigation -->
        <div class="wizard-nav">
            <button type="button" class="button2" @onclick="GoBack"
                    disabled="@(step == 1 || isWorking)">
                <i class="fa-solid fa-chevron-left"></i> Back
            </button>
            <span style="flex:1;"></span>

            @if (step < 3)
            {
                <button type="button" class="button1" @onclick="GoNext" disabled="@isWorking">
                    @if (isWorking)
                    {
                        <span><i class="fa-solid fa-spinner fa-spin"></i> Working…</span>
                    }
                    else
                    {
                        <span>Next <i class="fa-solid fa-chevron-right"></i></span>
                    }
                </button>
            }
            else if (!registered)
            {
                <button type="button" class="button1" @onclick="RegisterAsync" disabled="@isWorking">
                    @if (isWorking)
                    {
                        <span><i class="fa-solid fa-spinner fa-spin"></i> Saving…</span>
                    }
                    else
                    {
                        <span><i class="fa-solid fa-floppy-disk"></i> Register</span>
                    }
                </button>
            }
            else
            {
                <a href="/" class="button1" style="text-decoration:none;">
                    <i class="fa-solid fa-house"></i> Return to Home
                </a>
            }
        </div>

    </div>
</div>

@code {
    [Parameter] public Guid ScenarioId { get; set; }
    [SupplyParameterFromQuery] private string? Db { get; set; }

    [Inject] private DataMappingService MappingSvc { get; set; } = default!;
    [Inject] private ITenantContext TenantCtx { get; set; } = default!;

    private static readonly string[] StepLabels = ["Connect", "Filter", "Register"];

    private int step = 1;
    private ModelConfigDto config = new();
    private List<string> availableModels = new();
    private List<string> availablePeriods = new();
    private bool isWorking;
    private bool viewVerified;
    private bool registered;
    private string? workError;

    protected override async Task OnParametersSetAsync()
    {
        config = await MappingSvc.LoadConfigAsync(ScenarioId);
        config.ModelId = ScenarioId.ToString();

        if (string.IsNullOrEmpty(config.SourceDatabase) && !string.IsNullOrEmpty(Db))
            config.SourceDatabase = Db;
        if (string.IsNullOrEmpty(config.SourceSchema))
            config.SourceSchema = "PUBLIC";

        // If already configured, mark as verified and pre-load lists
        if (!string.IsNullOrEmpty(config.ConfigId))
        {
            viewVerified = true;
            try
            {
                await LoadFilterOptionsAsync();
            }
            catch (Exception ex)
            {
                workError = $"Could not load filter options: {ex.Message}";
            }
        }
    }

    private async Task GoNext()
    {
        workError = null;
        if (step == 1) await Step1Next();
        else if (step == 2) await Step2Next();
    }

    private void GoBack()
    {
        workError = null;
        if (step > 1) step--;
    }

    private async Task VerifyViewAsync()
    {
        if (string.IsNullOrWhiteSpace(config.SourceDatabase)) return;
        workError = null;
        isWorking = true;
        viewVerified = false;
        try
        {
            viewVerified = await MappingSvc.VerifyViewExistsAsync(config.SourceDatabase, config.SourceSchema);
            if (!viewVerified)
                workError = $"VW_APP_COURSE_UNIT_SUMMARY was not found in {config.SourceDatabase}.{config.SourceSchema}. " +
                            "Check the database and schema names, and ensure the view has been created.";
        }
        catch (Exception ex)
        {
            workError = $"Connection failed: {ex.Message}";
        }
        finally
        {
            isWorking = false;
        }
    }

    private async Task Step1Next()
    {
        if (string.IsNullOrWhiteSpace(config.SourceDatabase))
        {
            workError = "Source database name is required.";
            return;
        }

        if (!viewVerified)
        {
            await VerifyViewAsync();
            if (!viewVerified) return;
        }

        isWorking = true;
        try
        {
            await LoadFilterOptionsAsync();
            step++;
        }
        catch (Exception ex)
        {
            workError = $"Could not load filter options: {ex.Message}";
        }
        finally
        {
            isWorking = false;
        }
    }

    private Task Step2Next()
    {
        if (string.IsNullOrWhiteSpace(config.ModelFilter))
        {
            workError = "Select a model before continuing.";
            return Task.CompletedTask;
        }
        if (string.IsNullOrWhiteSpace(config.PeriodFilter))
        {
            workError = "Select a period before continuing.";
            return Task.CompletedTask;
        }
        step++;
        return Task.CompletedTask;
    }

    private async Task LoadFilterOptionsAsync()
    {
        availableModels  = await MappingSvc.GetAvailableModelsAsync(config.SourceDatabase, config.SourceSchema);
        availablePeriods = await MappingSvc.GetAvailablePeriodsAsync(config.SourceDatabase, config.SourceSchema);

        if (string.IsNullOrEmpty(config.ModelFilter) && availableModels.Count > 0)
            config.ModelFilter = availableModels[0];
        if (string.IsNullOrEmpty(config.PeriodFilter) && availablePeriods.Count > 0)
            config.PeriodFilter = availablePeriods[0];
    }

    private async Task RegisterAsync()
    {
        isWorking = true;
        workError = null;
        try
        {
            var access = await TenantCtx.GetAsync();
            if (!access.Ok)
            {
                workError = access.Reason;
                return;
            }
            await MappingSvc.SaveConfigAsync(config, access.TenantId);
            var error = await MappingSvc.RegisterModelAsync(config.ModelId, config.ModelFilter);
            if (string.IsNullOrEmpty(error))
                registered = true;
            else
                workError = error;
        }
        catch (Exception ex)
        {
            workError = $"Failed to register: {ex.Message}";
        }
        finally
        {
            isWorking = false;
        }
    }
}
