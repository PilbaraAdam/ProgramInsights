@page "/signed-out"
@attribute [AllowAnonymous]

<PageTitle>Signed out — Program Insights</PageTitle>

<div class="content-container">
    <div class="wizard-header">
        <h1 class="wizard-title">You're signed out</h1>
        <p class="wizard-subtitle">Your session has ended and your connection to Snowflake is closed.</p>
    </div>

    <div class="details-card" style="max-width:520px;">
        <a class="button1" href="MicrosoftIdentity/Account/SignIn">
            <i class="fa-solid fa-right-to-bracket me-2"></i>Sign in again
        </a>
    </div>
</div>
